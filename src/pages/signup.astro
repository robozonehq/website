---
import '@fontsource/commissioner';
---
<html>
<head>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <style>
    @font-face {
      font-family: "Signwood";
      src: url("/fonts/Signwood.ttf"), url("/fonts/SignwoodItalic.ttf");
    }

    .nav-item {
      font-family: "Signwood", sans-serif;
      font-size: 2.5em;
      padding: 0px 15px;
      margin: 10px 10px 0;
      transition: all 200ms ease-out;
      display: inline-block;
      line-height: 0.5;
    }

    .signup {
      height: 100%;
      position: relative;
      background-position: center;
      z-index: 200;
    }

    .nav {
      position: absolute;
      top: 2.4%;
      right: 5%;
      z-index: 100;
    }

    .nav .nav-item {
      color: black;
      border-bottom: 10px solid #FFD253;
      -webkit-transition: all 200ms ease-out;
    }

    .nav .nav-item:hover {
      border-bottom: 10px solid #75CDFF;
      -webkit-transform: translateY(-4px);
      transform: translateY(-4px);
    }

    .nav .nav-item:active {
      -webkit-transform: translateY(4px);
      transform: translateY(4px);
    }

    .nav .nav-select {
      border-bottom: 10px solid #75CDFF;
      display: inline-block;
      line-height: 0.5;
    }

    body,
    html {
      height: 100%;
      margin: 0;
      overflow-x: hidden;
    }

    .section {
      display: flex;
      justify-content: center;
      align-items: left;
      flex-direction: column;
      margin-left: 100px;
      margin-top: 10%;
      padding-left: 5%;
    }

    .header {
      font-family: "Signwood", sans-serif;
      font-style: italic;
      font-size: 5em;
      line-height: 0;
      margin: 0 0 50px;
      border-bottom: 0.5em solid #75CDFF;
      width: fit-content;
    }

    .para {
      font-family: "Commissioner", sans-serif;
      width: 40%;
      font-size: 1.5em;
    }

    .txt {
        margin-top: 1em;
        font-family: "Signwood", sans-serif;
        width: 40%;
        font-size: 3vh;
    }

    .btn-dark {
      font-family: "Signwood", sans-serif;
      font-size: 3em;
      font-style: italic;
      padding: 12px 55px;
      border-radius: 0px;
      background: black;
      color: white;
      border: none;
      margin-top: 20px;
      box-shadow: 9px 9px 0px #FFD253;
      transition: 300ms;
      width: 6em;
      z-index: 100;
    }

    .btn-dark:hover {
      box-shadow: 14px 14px 0px #FFD253;
      -webkit-transform: translateY(-4px);
      -webkit-transform: translateX(-4px);
      transform: translateY(-4px);
      transform: translateX(-4px);
    }

    .btn-dark:active {
      box-shadow: 4px 4px 0px #FFD253;
      -webkit-transform: translateY(4px);
      -webkit-transform: translateX(4px);
      transform: translateY(4px);
      transform: translateX(4px);
    }

    .btn-select {
      background: #FFD253;
      box-shadow: 9px 9px 0px black;
      color: black;
    }

    .btn-select:hover {
      box-shadow: 14px 14px 0px black;
    }

    .btn-select:active {
      box-shadow: 4px 4px 0px black;
    }

    .btn-donate {
      box-shadow: 9px 9px 0px #79e486;
    }

    .btn-donate:hover {
      box-shadow: 14px 14px 0px #79e486;
    }

    .btn-donate:active {
      box-shadow: 4px 4px 0px #79e486;
    }

    .sticky-bg {
      position: -webkit-sticky;
      position: sticky;
      height: 100%;
      bottom: 0;
    }

    .corner {
      position: absolute;
      width: 12em;
      height: 12em;
      background: #FFD253;
      clip-path: polygon(85% 0, 85% 35%, 35% 35%, 35% 85%, 0 85%, 0 100%, 50% 100%, 50% 50%, 100% 50%, 100% 0);
    }

    .corner-tl {
      top: 0;
      left: 0;
    }

    .corner-br {
      right: 0;
      bottom: 0;
      transform: rotate(180deg);
    }
     
    .choice {
        display: flex;
        flex-direction: row;
        width: fit-content;
        margin: 40px 0;
    }

    [contenteditable] {
      outline: 0px solid transparent;
    }

    input[type="radio"] {
      z-index: 1000;
      accent-color: #FFD253;
    }
    .option {
      margin: 0 20px;
      width: fit-content;
      font-size: 2vw !important;
      white-space: nowrap;
    }

    .input {
      min-width: 9em;
      width: fit-content;
      border: none;
      font-size: 2.6vh;
      font-family: "Commissioner", sans-serif;
      color: #666;
      margin-left: 10px;
      padding: 15px 0 5px;
      border-bottom: 0.4rem solid #DDD;
      transition: all 0.1s ease-in;
      white-space: nowrap;
    }

    .input:focus {
      border: none;
      border-bottom: 0.6rem solid #FFD253;
    }
  </style>
</head>

<body>
  <div class="navbar nav">
    <a class="nav-item home">Home</a>
    <a class="nav-item about">About</a>
    <a class="nav-item support">Support</a>
  </div>
<div class="signup">
    <div class="section">
      <div class="header">Sign Up</div>
      <div class="para">
          Welcome to our sign ups for RoboZone. This course will take place in July-August Summer 2024 from [3 Hour Time Frame] at [Location].
      </div>
      <div class="txt">
          First Name:
      </div>
      <span class="input" contenteditable></span>
      <div class="txt">
          Last Name:
      </div>
      <span class="input" contenteditable></span>
      <div class="txt">
          What grade will you be entering during the next school year?
      </div>
      <div class="txt choice">
          <div class="btn-dark option">
            6th Grade
          </div>
          <div class="btn-dark option">
            7th Grade
          </div>
          <div class="btn-dark option">
            8th Grade
          </div>
          <div class="btn-dark option">
            9th Grade
          </div>
      </div>
      <div class="txt">
          Student Email:
      </div>
      <span class="input" contenteditable></span>
      <div class="txt">
          Guardian First Name:
      </div>
      <span class="input" contenteditable></span>
      <div class="txt">
          Guardian Last Name:
      </div>
      <span class="input" contenteditable></span>
      <div class="txt">
          Guardian Email:
      </div>
      <span class="input" contenteditable></span>

      <button class="btn-dark signup">SIGN UP</button>
    </div>
</div>
  <div class="sticky-bg">
    <div class="corner corner-tl"></div>
    <div class="corner corner-br"></div>
  </div>

  <!-- JavaScript -->
  <script>
    const grades = document.querySelectorAll('.option');
    let select;
    
    grades.forEach((el) => el.addEventListener("click", () => {
      if (select != null) select.classList.remove("btn-select");
      el.classList.add("btn-select");
      select = el;
      console.log("done");
    }));
  </script>
</body>

</html>
