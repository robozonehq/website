---
import "@fontsource-variable/dm-sans";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="RoboZone - Sign Up">
    <Navbar />

    <!-- Signup Section -->
    <section class="signup-section">
        <div class="container">
            <div class="section-header">
                <h1>Sign Up</h1>
                <p class="section-intro">
                    Thanks for signing up! The course takes place July to
                    August, with 2 hour workshops every Monday and Friday from
                    4-6PM. Sign up quick, as signups will close once we have 15
                    students! Once you register, we'll get back to you with
                    billing details.
                </p>
                <p class="price-info">
                    <strong>Cost: $175</strong> | Session: July 21st - August 15th
                </p>
            </div>

            <div class="form-container">
                <form id="signup-form" class="signup-form">
                    <div class="form-group">
                        <label for="name">Student Full Name</label>
                        <input
                            type="text"
                            id="name"
                            placeholder="Enter student's full name"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label>Student Grade</label>
                        <div class="grade-options">
                            <button
                                type="button"
                                class="grade-btn"
                                data-grade="5">5th Grade</button
                            >
                            <button
                                type="button"
                                class="grade-btn"
                                data-grade="6">6th Grade</button
                            >
                            <button
                                type="button"
                                class="grade-btn"
                                data-grade="7">7th Grade</button
                            >
                            <button
                                type="button"
                                class="grade-btn"
                                data-grade="8">8th Grade</button
                            >
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="email">Student Email</label>
                        <input
                            type="email"
                            id="email"
                            placeholder="Enter student's email"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="guardian">Guardian Full Name</label>
                        <input
                            type="text"
                            id="guardian"
                            placeholder="Enter guardian's full name"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="guardian-email">Guardian Email</label>
                        <input
                            type="email"
                            id="guardian-email"
                            placeholder="Enter guardian's email"
                            required
                        />
                    </div>

                    <div class="form-action">
                        <button type="submit" class="submit-btn">Sign Up</button
                        >
                    </div>

                    <div class="form-messages">
                        <p class="error-message">
                            Please fill out all required fields.
                        </p>
                        <p class="success-message">
                            Thank you for signing up! You will receive a
                            confirmation email soon (about 2 business days).
                        </p>
                        <p class="fail-message">
                            Failed to submit form. Please try again later.
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- Corner Decorations -->
    <div class="corner top-left"></div>
    <div class="corner bottom-right"></div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>
                &copy; {new Date().getFullYear()} RoboZone. All rights reserved.
            </p>
        </div>
    </footer>
</Layout>

<style>
    /* Font loading */
    @font-face {
        font-family: "Signwood";
        src: url("/fonts/Signwood.ttf"), url("/fonts/SignwoodItalic.ttf");
        font-display: swap;
    }

    /* Base styles */
    :root {
        --primary: #53c1ff;
        --secondary: #ffd253;
        --dark: #000000;
        --light: #ffffff;
        --gray: #f5f5f5;
        --gray-dark: #666666;
        --gray-light: #e9e9e9;
        --success: #79e486;
        --error: #ff5353;
        --transition: all 0.3s ease;
    }

    .container {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
    }

    /* Navigation is now handled by the OriginalNavbar component */

    /* Signup Section */
    .signup-section {
        padding: 100px 0 60px;
        min-height: 100vh;
        position: relative;
        z-index: 1;
    }

    .section-header {
        text-align: center;
        margin-bottom: 36px;
    }

    .section-header h1 {
        font-family: "Signwood", sans-serif;
        font-style: italic;
        font-size: 36px;
        margin-bottom: 16px;
    }

    /* Removed highlight styling */

    .section-intro {
        max-width: 800px;
        margin: 0 auto 14px;
        color: var(--gray-dark);
        line-height: 1.6;
        font-size: 16px;
    }

    .price-info {
        font-size: 16px;
        margin-bottom: 24px;
        color: var(--gray-dark);
    }

    /* Form Styles */
    .form-container {
        max-width: 650px;
        margin: 0 auto;
        background: var(--light);
        border-radius: 8px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        padding: 32px;
        position: relative;
        z-index: 2;
    }

    .signup-form {
        display: grid;
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group label {
        font-family: "Signwood", sans-serif;
        font-style: italic;
        font-size: 18px;
        margin-bottom: 8px;
    }

    .form-group input {
        padding: 10px 14px;
        border: 1px solid var(--gray-light);
        border-radius: 4px;
        font-size: 16px;
        font-family: "DM Sans Variable", system-ui, sans-serif;
        transition: var(--transition);
    }

    .form-group input:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 2px rgba(83, 193, 255, 0.2);
    }

    .grade-options {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
        gap: 10px;
    }

    .grade-btn {
        background: var(--gray-light);
        border: none;
        padding: 8px;
        border-radius: 4px;
        font-family: "Signwood", sans-serif;
        font-style: italic;
        font-size: 16px;
        cursor: pointer;
        transition: var(--transition);
    }

    .grade-btn:hover {
        background: var(--gray);
    }

    .grade-btn.active {
        background: var(--secondary);
        color: var(--dark);
    }

    .form-action {
        margin-top: 12px;
    }

    .submit-btn {
        width: 100%;
        padding: 10px;
        background: var(--dark);
        color: var(--light);
        border: none;
        border-radius: 4px;
        font-family: "Signwood", sans-serif;
        font-style: italic;
        font-size: 18px;
        cursor: pointer;
        box-shadow: 4px 4px 0 var(--secondary);
        transition: var(--transition);
    }

    .submit-btn:hover {
        transform: translate(-2px, -2px);
        box-shadow: 6px 6px 0 var(--secondary);
    }

    /* Form Messages */
    .form-messages p {
        padding: 12px;
        border-radius: 4px;
        margin-top: 16px;
        display: none;
        text-align: center;
        font-size: 14px;
    }

    .error-message {
        background-color: rgba(255, 83, 83, 0.1);
        color: var(--error);
    }

    .success-message {
        background-color: rgba(121, 228, 134, 0.1);
        color: var(--success);
    }

    .fail-message {
        background-color: rgba(255, 83, 83, 0.1);
        color: var(--error);
    }

    /* Decorative Corners */
    .corner {
        position: fixed;
        width: 150px;
        height: 150px;
        z-index: 0;
    }

    .top-left {
        top: 0;
        left: 0;
        background: var(--secondary);
        clip-path: polygon(0 0, 100% 0, 0 100%);
    }

    .bottom-right {
        bottom: 0;
        right: 0;
        background: var(--secondary);
        clip-path: polygon(100% 0, 100% 100%, 0 100%);
    }

    /* Footer */
    .footer {
        background-color: var(--dark);
        color: var(--light);
        padding: 24px 0;
        text-align: center;
        position: relative;
        z-index: 2;
        font-size: 14px;
    }

    /* Media Queries */
    @media (max-width: 768px) {
        .section-header h1 {
            font-size: 32px;
        }

        .form-container {
            padding: 24px;
        }

        .grade-options {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 576px) {
        .signup-section {
            padding: 80px 0 50px;
        }

        .section-header h1 {
            font-size: 28px;
        }

        .form-container {
            padding: 20px;
        }

        .form-group label {
            font-size: 16px;
        }

        .corner {
            width: 100px;
            height: 100px;
        }
    }
</style>

<script>
    import PocketBase from "pocketbase";

    document.addEventListener("DOMContentLoaded", () => {
        // Initialize PocketBase
        const pb = new PocketBase("https://robozonenj.org/admin");

        // Form elements
        const form = document.getElementById("signup-form") as HTMLFormElement;
        const gradeButtons = document.querySelectorAll(".grade-btn");
        const errorMessage = document.querySelector(
            ".error-message",
        ) as HTMLElement;
        const successMessage = document.querySelector(
            ".success-message",
        ) as HTMLElement;
        const failMessage = document.querySelector(
            ".fail-message",
        ) as HTMLElement;

        let selectedGrade: string | null = null;

        // Handle grade button selection
        gradeButtons.forEach((button) => {
            button.addEventListener("click", () => {
                // Remove active class from all buttons
                gradeButtons.forEach((btn) => btn.classList.remove("active"));

                // Add active class to clicked button
                button.classList.add("active");

                // Store selected grade
                selectedGrade = button.getAttribute("data-grade");
            });
        });

        // Form submission
        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            // Hide all messages
            errorMessage.style.display = "none";
            successMessage.style.display = "none";
            failMessage.style.display = "none";

            // Get form values
            const nameInput = document.getElementById(
                "name",
            ) as HTMLInputElement;
            const emailInput = document.getElementById(
                "email",
            ) as HTMLInputElement;
            const guardianInput = document.getElementById(
                "guardian",
            ) as HTMLInputElement;
            const guardianEmailInput = document.getElementById(
                "guardian-email",
            ) as HTMLInputElement;

            const name = nameInput.value.trim();
            const email = emailInput.value.trim();
            const guardian = guardianInput.value.trim();
            const guardianEmail = guardianEmailInput.value.trim();

            // Validate form
            if (
                !name ||
                !email ||
                !guardian ||
                !guardianEmail ||
                !selectedGrade
            ) {
                errorMessage.style.display = "block";
                return;
            }

            // Prepare data for submission
            const data = {
                name,
                email,
                guardian,
                guardian_email: guardianEmail,
                grade: parseInt(selectedGrade),
            };

            try {
                // Submit data to PocketBase
                const record = await pb.collection("signups").create(data);

                if (record && record.id) {
                    // Success
                    successMessage.style.display = "block";
                    form.reset();

                    // Remove active class from grade buttons
                    gradeButtons.forEach((btn) =>
                        btn.classList.remove("active"),
                    );
                    selectedGrade = null;
                } else {
                    // Failed
                    failMessage.style.display = "block";
                }
            } catch (error) {
                console.error("Error submitting form:", error);
                failMessage.style.display = "block";
            }
        });
    });
</script>
