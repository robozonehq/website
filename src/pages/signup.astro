---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import CourseFacts from "../components/CourseFacts.astro";
import ProgramStatus from "../components/ProgramStatus.astro";
import InPersonAvailability from "../components/InPersonAvailability.astro";
import InquiryList from "../components/InquiryList.astro";
import SignupForm from "../components/SignupForm.astro";
import OnlinePlan from "../components/OnlinePlan.astro";
import WorkshopPhoto from "../components/WorkshopPhoto.astro";
import { site, offerings, sessions, mailto, onlineWorkshops } from "../data/site";
import { formatDate, gradeRange } from "../lib/registration";
import { allAvailability } from "../lib/programs";
import { todayISO } from "../lib/registration";

const a = allAvailability(offerings, sessions, todayISO());
const local = a.inPerson.registrable;
const localForm = local && local.registration.kind === "signup-form" ? local : null;
const online = a.online.registrable;
const onlineLink = online && online.registration.kind === "link" ? online.registration.url : null;
---

<Layout
  title="Program availability and updates | RoboZone"
  crumb="Program updates"
  description="Where each RoboZone program stands: the in-person course in South Brunswick, NJ, the free online workshops being planned, and local branches. Plus how to ask about the one you're interested in."
>
  <PageHeader
    label="Program updates"
    title="Program availability and updates"
    lede="Where each RoboZone program stands right now, and how to ask about the one you're interested in."
  />

  <section class="section section--flush" id="in-person" aria-labelledby="inperson-heading">
    <div class="container">
      <div class="block-head">
        <p class="annot">Local · {site.originShort}</p>
        <h2 id="inperson-heading">{localForm ? `Sign up for ${localForm.name}` : "In-person workshops"}</h2>
      </div>

      {
        localForm ? (
          <div class="signup-layout">
            <div class="signup-layout__details">
              <InPersonAvailability showRegister={false} />
              <h3 class="h-sub h-sub--spaced">Before you sign up</h3>
              <CourseFacts />
              <h3 class="h-sub h-sub--spaced">What happens next</h3>
              <ol class="steps" role="list">
                <li>
                  <span class="steps__num" aria-hidden="true">1</span>
                  <span>Fill out and send the form on this page.</span>
                </li>
                <li>
                  <span class="steps__num" aria-hidden="true">2</span>
                  <span>
                    We email the parent or guardian within about two business days with a confirmation and billing details.
                  </span>
                </li>
                <li>
                  <span class="steps__num" aria-hidden="true">3</span>
                  <span>Your student comes to the first workshop and starts building.</span>
                </li>
              </ol>
            </div>
            <div class="signup-layout__form">
              <SignupForm session={localForm} />
            </div>
          </div>
        ) : (
          <div class="local-layout">
            <InPersonAvailability />
            {!local && <div class="local-layout__info">
              <h3 class="h-sub">How in-person sign-up has worked</h3>
              <p>
                For past sessions, families filled out a short form on this page with their student's name, grade, and
                email, plus a parent or guardian's name and email. We then emailed a confirmation and billing details,
                usually within about two business days.
              </p>
              <p class="muted">
                When the next session is announced, its dates, location, grades, and fee will be listed here before you
                sign up.
              </p>
              <a class="link-arrow" href="/program#in-person">
                About the in-person course <Icon name="arrow-right" />
              </a>
              <WorkshopPhoto
                photo="handsOnWiring"
                aspect="4 / 3"
                sizes="(min-width: 64rem) 560px, 100vw"
                widths={[480, 720, 900]}
              />
            </div>}
          </div>
        )
      }
    </div>
  </section>

  <section class="section section--sunken" id="online" aria-labelledby="online-heading">
    <div class="container online">
      <div class="block-head">
        <ProgramStatus availability={a.online} />
        <h2 id="online-heading">Online classes</h2>
      </div>
      <div class="online__body stack">
        {
          online && onlineLink ? (
            <>
              <p><strong>{online.name}</strong> is open for registration.</p>
              <dl class="facts">
                <div><dt>Dates</dt><dd>{online.dates}<small>{online.schedule}</small></dd></div>
                <div><dt>Time zone</dt><dd>{online.timezone}</dd></div>
                <div><dt>Grades</dt><dd>{gradeRange(online.grades)}</dd></div>
                <div><dt>Cost</dt><dd>{online.fee}</dd></div>
                <div><dt>Closes</dt><dd>{formatDate(online.registrationCloses)}</dd></div>
                <div><dt>Equipment</dt><dd>A computer with internet access<small>No physical electronics, kits, or 3D printing.</small></dd></div>
              </dl>
              <p>{online.afterRegistering}</p>
              <a class="btn btn--primary" href={onlineLink} rel="noopener">Register for {online.name}</a>
            </>
          ) : (
            <>
              <p>
                {offerings.online.summary} Class dates and registration have not been announced.{" "}
                {offerings.online.openQuestions}
              </p>
              <OnlinePlan />
            </>
          )
        }
        <p class="muted small">{onlineWorkshops.donationNote}</p>
        <p class="muted">
          Online workshops are planned separately from the in-person course, so their timing doesn't depend on the next
          South Brunswick session.
        </p>
        <div class="online__actions">
          <a class="btn btn--secondary" href={mailto(offerings.online.inquiry.subject)}>
            <Icon name="mail" /> {offerings.online.inquiry.label}
          </a>
          <a class="link-arrow" href="/program#online">More about online workshops <Icon name="arrow-right" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="ask" aria-labelledby="ask-heading">
    <div class="container ask">
      <div class="block-head">
        <p class="annot">Ask a question</p>
        <h2 id="ask-heading">Choose what you'd like to ask about</h2>
        <p class="muted">Each link opens an email to {site.email} with a subject line filled in.</p>
      </div>
      <InquiryList />
    </div>
  </section>
</Layout>

<style>
  .section--flush {
    padding-top: 0;
  }

  .block-head {
    display: grid;
    gap: var(--space-3);
    max-width: 46rem;
    margin-bottom: var(--space-6);
  }

  .h-sub {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }

  .h-sub--spaced {
    margin-top: var(--space-7);
  }

  .signup-layout {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 64rem) {
    .signup-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  .steps {
    display: grid;
    gap: var(--space-4);
  }

  .steps li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .steps__num {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    font-family: var(--font-mono);
    font-weight: 500;
    background: var(--brand-yellow);
    border: 1.5px solid var(--color-text);
    border-radius: var(--radius-sm);
  }

  .local-layout {
    display: grid;
    gap: var(--space-7);
  }

  .local-layout__info {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    justify-items: start;
    max-width: 36rem;
  }

  .local-layout__info .h-sub {
    margin-bottom: 0;
  }

  @media (min-width: 64rem) {
    .local-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  .online {
    display: grid;
    gap: var(--space-2);
  }

  .online .block-head {
    margin-bottom: var(--space-3);
  }

  .online__body {
    max-width: var(--measure);
  }

  .online__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
  }

  .small {
    font-size: var(--text-sm);
  }

  .online__actions .btn {
    white-space: normal;
  }
</style>
