---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import WaysToLearn from "../components/WaysToLearn.astro";
import ProgramStatus from "../components/ProgramStatus.astro";
import CourseFacts from "../components/CourseFacts.astro";
import InPersonAvailability from "../components/InPersonAvailability.astro";
import LearningJourney from "../components/LearningJourney.astro";
import StudentWork from "../components/StudentWork.astro";
import WorkshopPhoto from "../components/WorkshopPhoto.astro";
import Faq from "../components/Faq.astro";
import NextStep from "../components/NextStep.astro";
import OnlinePlan from "../components/OnlinePlan.astro";
import {
  inPersonCourse,
  impact,
  site,
  links,
  offerings,
  sessions,
  mailto,
  faqGeneral,
  faqInPerson,
  fiscalSponsor,
} from "../data/site";
import { allAvailability, enrollFaq } from "../lib/programs";
import { todayISO } from "../lib/registration";

const a = allAvailability(offerings, sessions, todayISO());
const generalItems = [faqGeneral[0], faqGeneral[1], enrollFaq(a.inPerson, a.online), ...faqGeneral.slice(2)];
---

<Layout
  title="Programs | RoboZone"
  description="RoboZone's established in-person robotics course in South Brunswick, NJ (circuits, Arduino C++, CAD, and a final project), plus the free online workshops we're planning and the local branches we're exploring."
>
  <PageHeader
    label="Programs"
    title="Programs"
    lede="RoboZone's established program is an in-person robotics course in South Brunswick, New Jersey. We're also planning free online workshops and exploring local branches in other communities. Here's where each one stands."
  />

  <section class="section section--tight" aria-label="Program overview">
    <div class="container">
      <WaysToLearn variant="index" />
    </div>
  </section>

  <section class="section section--sunken" id="in-person" aria-labelledby="inperson-heading">
    <div class="container">
      <div class="scope__head">
        <p class="annot">In-person course · {site.originShort}</p>
        <h2 id="inperson-heading">Robotics from the first circuit up</h2>
        <p class="lede">{inPersonCourse.summary}</p>
      </div>

      <div class="overview">
        <div class="overview__facts">
          <h3 class="h-sub">At a glance</h3>
          <CourseFacts />
          <p class="small muted">
            These details describe the in-person course. Online classes or branches, if they launch, will list their own.
          </p>
        </div>
        <div class="overview__side">
          <InPersonAvailability />
          <WorkshopPhoto
            photo="breadboardWiring"
            aspect="4 / 3"
            sizes="(min-width: 64rem) 460px, 100vw"
            widths={[480, 720, 960, 1280]}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="curriculum" aria-labelledby="curriculum-heading">
    <div class="container">
      <div class="section-head">
        <p class="annot">In-person course · What students learn</p>
        <h2 id="curriculum-heading">Four stages, eight weeks</h2>
        <p>
          The in-person course is grouped by skill rather than by week. Each stage builds on hardware and code students
          already have working.
        </p>
      </div>
      <LearningJourney detailed />
      <p class="tools-note muted">
        Tools students use: an <a href={links.arduino} rel="noopener">Arduino</a> board programmed in C++, breadboards
        and electronic components, <a href={links.onshape} rel="noopener">Onshape</a> for CAD, and a 3D printer.
      </p>
    </div>
  </section>

  <section class="section section--dark on-dark" id="builds" aria-labelledby="builds-heading">
    <div class="container">
      <div class="section-head">
        <p class="annot">In-person course · What students build</p>
        <h2 id="builds-heading">Working builds at every stage</h2>
        <p>Students build something at every stage, so their progress is right there on the table.</p>
      </div>
      <StudentWork />
    </div>
  </section>

  <section class="section" id="teaching" aria-labelledby="teaching-heading">
    <div class="container teaching">
      <div class="teaching__intro">
        <div class="section-head teaching__head">
          <p class="annot">In-person course · Who teaches</p>
          <h2 id="teaching-heading">Taught by high school mentors</h2>
          <p>
            RoboZone is run by high school students. {impact.items[2].value} mentors have been involved in our in-person
            workshops since {site.founded}.
          </p>
        </div>
        <WorkshopPhoto
          photo="workshopRoom"
          aspect="4 / 3"
          sizes="(min-width: 64rem) 480px, 100vw"
          widths={[480, 720, 960, 1280]}
        />
      </div>
      <ul role="list" class="principles">
        <li>
          <h3>Ask early, ask often</h3>
          <p>Mentors work alongside students at the table. Questions are part of every workshop, not an interruption.</p>
        </li>
        <li>
          <h3>Debugging is part of the work</h3>
          <p>A wire in the wrong row or a missing semicolon happens to everyone. Finding the problem is how students learn how circuits and code actually work.</p>
        </li>
        <li>
          <h3>Room to go further</h3>
          <p>Challenges come in different levels, and some lessons add extension challenges, like taking a servo build further. Experienced students still have something to work on.</p>
        </li>
      </ul>
      <a class="link-arrow" href="/about#team">Meet the team <Icon name="arrow-right" /></a>
    </div>
  </section>

  <section class="section section--sunken" id="online" aria-labelledby="online-heading">
    <div class="container idea">
      <div class="idea__head">
        <ProgramStatus availability={a.online} />
        <h2 id="online-heading">Online classes</h2>
        <p class="lede">{offerings.online.summary}</p>
      </div>
      <div class="idea__body stack">
        <p>
          Families outside South Brunswick can't learn with RoboZone today. Free online workshops are how we plan to change
          that, teaching the same ideas step by step, entirely on screen.
        </p>
        <OnlinePlan activities />
        <p>
          <strong>Online workshops haven't launched.</strong> Class dates and registration have not been announced.
          {offerings.online.openQuestions}
        </p>
        <p class="muted">
          They're separate from the in-person course: they won't use its venue, schedule, fees, or physical equipment, and
          its grade range doesn't automatically apply.
        </p>
        <p class="muted">
          The robot arm on our homepage is an on-screen illustration of servo angles. It isn't an online class.
        </p>
        <div class="idea__actions">
          <a class="btn btn--secondary" href={mailto(offerings.online.inquiry.subject)}>
            <Icon name="mail" /> {offerings.online.inquiry.label}
          </a>
          <p class="small muted">Emailing us is a question. It doesn't enroll you or add you to a list.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="branches" aria-labelledby="branches-heading">
    <div class="container idea">
      <div class="idea__head">
        <ProgramStatus availability={a.branches} />
        <h2 id="branches-heading">Local branches</h2>
        <p class="lede">{offerings.branches.summary}</p>
      </div>
      <div class="idea__body stack">
        <p>
          A branch would be a group in another community running hands-on workshops the way we do in South Brunswick:
          small groups, real hardware, and mentors at the table. <strong>No other branches exist yet</strong>, and there's
          no application or approval process. {offerings.branches.openQuestions}
        </p>
        <dl class="distinctions">
          <div>
            <dt>Hosting is not the same as a branch</dt>
            <dd>
              A school, library, or community space that hosts RoboZone workshops is a host. That's how our in-person
              workshops have run, and it doesn't make the host a branch.
            </dd>
          </div>
          <div>
            <dt>Fiscal sponsorship stays with RoboZone</dt>
            <dd>
              {fiscalSponsor.statement} That arrangement covers RoboZone. It wouldn't automatically extend to other groups
              or future branches.
            </dd>
          </div>
        </dl>
        <div class="idea__actions">
          <a class="btn btn--secondary" href={mailto(offerings.branches.inquiry.subject)}>
            <Icon name="mail" /> {offerings.branches.inquiry.label}
          </a>
          <a class="link-arrow" href="/get-involved#partner">Hosting and partnering <Icon name="arrow-right" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sunken" id="faq" aria-labelledby="faq-heading">
    <div class="container faq-layout">
      <div class="section-head">
        <p class="annot">Questions</p>
        <h2 id="faq-heading">Practical details</h2>
        <p>Something else? Email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
      <div class="faq-groups">
        <h3 class="faq-groups__title">About RoboZone's programs</h3>
        <Faq items={generalItems} />
        <h3 class="faq-groups__title">About the in-person course</h3>
        <Faq items={faqInPerson} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <NextStep showProgramsLink={false} />
    </div>
  </section>
</Layout>

<style>
  .section--tight {
    padding-top: 0;
  }

  .h-sub {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }

  .small {
    font-size: var(--text-sm);
  }

  .scope__head {
    display: grid;
    gap: var(--space-3);
    max-width: 46rem;
    margin-bottom: var(--space-7);
  }

  .overview {
    display: grid;
    gap: var(--space-7);
  }

  .overview__facts .small {
    margin-top: var(--space-4);
  }

  .overview__side {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  @media (min-width: 64rem) {
    .overview {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  .tools-note {
    margin-top: var(--space-7);
    max-width: var(--measure);
    font-size: var(--text-sm);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .teaching {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .teaching__head {
    margin-bottom: var(--space-3);
  }

  .teaching__intro {
    display: grid;
    gap: var(--space-6);
    width: 100%;
  }

  @media (min-width: 64rem) {
    .teaching__intro {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: center;
    }
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    border-top: 2px solid var(--color-text);
    padding-top: var(--space-5);
    margin-bottom: var(--space-3);
  }

  .principles h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
  }

  .principles p {
    color: var(--color-text-muted);
  }

  @media (max-width: 52rem) {
    .principles {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  .idea {
    display: grid;
    gap: var(--space-6);
  }

  .idea__head {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-top: var(--space-5);
    border-top: 2px dashed var(--color-border-strong);
  }

  .idea__body {
    max-width: var(--measure);
  }

  .idea__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
  }

  .idea__actions .btn {
    white-space: normal;
  }

  .distinctions {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .distinctions > div {
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-border);
  }

  .distinctions dt {
    font-weight: 700;
    margin-bottom: var(--space-1);
  }

  .distinctions dd {
    color: var(--color-text-muted);
  }

  @media (min-width: 64rem) {
    .idea {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
      gap: var(--space-8);
    }
  }

  .faq-layout {
    display: grid;
    gap: var(--space-5);
  }

  .faq-groups__title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .faq-groups__title:not(:first-child) {
    margin-top: var(--space-7);
  }

  @media (min-width: 64rem) {
    .faq-layout {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-8);
      align-items: start;
    }
  }
</style>
