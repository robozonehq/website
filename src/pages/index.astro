<html>

<head>
  <style>
    @font-face {
      font-family: "Signwood";
      src: url("/fonts/Signwood.ttf"), url("/fonts/SignwoodItalic.ttf");
    }

    .title {
      font-family: "Signwood", sans-serif;
      font-style: italic;
      font-size: 10em;
      text-shadow: 7px 10px 0px black;
      z-index: 50;
    }

    .desc {
      font-family: "Signwood", sans-serif;
      font-size: 2em;
      text-align: center;
    }

    .hero {
      background: rgb(117, 205, 255);
      background: linear-gradient(0deg, rgba(117, 205, 255, 1) 0%, rgba(0, 108, 207, 1) 100%);
      height: 100%;
      position: relative;
      background-position: center;
    }

    .content {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      color: white;
      height: 100%;
    }

    .btn {
      font-family: "Signwood", sans-serif;
      font-size: 3em;
      font-style: italic;
      padding: 12px 55px;
      border-radius: 0px;
      background: white;
      border: none;
      margin-top: 20px;
      box-shadow: 9px 9px 0px black;
      transition: 300ms;
    }

    .btn:hover {
      box-shadow: 14px 14px 0px black;
      -webkit-transform: translateY(-4px);
      -webkit-transform: translateX(-4px);
      transform: translateY(-4px);
      transform: translateX(-4px);
    }

    .btn:active {
      box-shadow: 4px 4px 0px black;
      -webkit-transform: translateY(4px);
      -webkit-transform: translateX(4px);
      transform: translateY(4px);
      transform: translateX(4px);
    }

    @keyframes float {
      from {
        left: -25%;
      }

      to {
        left: 100%;
      }
    }

    .cloud {
      position: absolute;
      top: 25px;
      left: -25%;
      width: 25%;
      animation: 30s linear -5s infinite float;
    }

    .cloud-long {
      position: absolute;
      bottom: 50px;
      left: -25%;
      width: 25%;
      animation: 30s linear 0s infinite float;
    }

    @keyframes wipe-in-up {
      from {
        clip-path: inset(100% 0 0 0);
      }

      to {
        clip-path: inset(0 0 0 0);
      }
    }

    .nav-hero {
      position: absolute;
      top: 2.4%;
      right: 5%;
      z-index: 100;
    }

    .nav-item {
      font-family: "Signwood", sans-serif;
      font-size: 2.5em;
      padding: 0px 15px;
      margin: 10px 10px 0;
      transition: all 200ms ease-out;
      display: inline-block;
      line-height: 0.5;
    }

    .nav-hero .nav-item {
      color: white;
      /* Hacky Border Workaround */
      text-shadow:
        3px 0px 0 #006CCF,
        3px 1px 0 #006CCF,
        3px 2px 0 #006CCF,
        3px 3px 0 #006CCF,
        2px 3px 0 #006CCF,
        1px 3px 0 #006CCF,
        0px 3px 0 #006CCF,
        -1px 3px 0 #006CCF,
        -2px 3px 0 #006CCF,
        -3px 3px 0 #006CCF;
      border-bottom: 0px solid white;
      -webkit-transition: all 200ms ease-out;
    }

    .nav-hero .nav-item:hover {
      border-bottom: 10px solid white;
    }

    .nav-hero .nav-item:active {
      -webkit-transform: translateY(4px);
      transform: translateY(4px);
    }

    .nav-hero .nav-select {
      display: inline-block;
      border-bottom: 10px solid white;
      line-height: 0.5;
    }

    .about-section {
      background: white;
      height: 100%;
      position: relative;
      background-position: center;
    }

    .nav {
      position: absolute;
      top: 2.4%;
      right: 5%;
      z-index: 100;
    }

    .nav .nav-item {
      color: black;
      border-bottom: 10px solid #FFD253;
      -webkit-transition: all 200ms ease-out;
    }

    .nav .nav-item:hover {
      border-bottom: 10px solid #75CDFF;
      -webkit-transform: translateY(-4px);
      transform: translateY(-4px);
    }

    .nav .nav-item:active {
      -webkit-transform: translateY(4px);
      transform: translateY(4px);
    }

    .nav .nav-select {
      border-bottom: 10px solid #75CDFF;
      display: inline-block;
      line-height: 0.5;
    }

    body,
    html {
      height: 100%;
      margin: 0;
      overflow-x: hidden;
    }

  </style>
</head>

<body>
  <div class="navbar nav-hero">
    <a class="nav-item nav-select home">Home</a>
    <a class="nav-item about">About</a>
    <a class="nav-item support">Support</a>
  </div>
  <div class="hero">
    <div class="content">
      <div class="title">ROBOZONE</div>
      <div class="desc">Interactive courses teaching students engineering, computer science, and robotics principles.
      </div>
      <button class="btn">SIGN UP</button>
    </div>
    <img src="/images/cloud.png" class="cloud" />
    <img src="/images/cloud_long.png" class="cloud-long" />
  </div>
  <div class="about-section">
    stuff
  </div>
  <script>
    import createScrollSnap from 'scroll-snap';
    const element = document.body;
    const home = document.querySelector(".home");
    const about = document.querySelector(".about");

    home.addEventListener("click", () => {
      document.querySelector(".hero").scrollIntoView({ behavior: "smooth" });
    });

    about.addEventListener("click", () => {
      document.querySelector(".about-section").scrollIntoView({ behavior: "smooth" });
    });

    // Scroll snapper
    const { bind, unbind } = createScrollSnap(element, {
      snapDestinationX: '0%',
      snapDestinationY: '100%',
      timeout: 100,
      duration: 300,
      threshold: 0.2,
      snapStop: false,
    }, () => {
      console.log('snapped');
      const hero = document.querySelector('.hero'); 
      const navbar = document.querySelector('.navbar'); 
       
      const herorect = hero.getBoundingClientRect(); 
      const navrect = navbar.getBoundingClientRect(); 
       
      if (!(herorect.right < navrect.left ||  
            herorect.left > navrect.right ||  
            herorect.bottom < navrect.top ||  
            herorect.top > navrect.bottom)) { 
        // Hero page
        navbar.classList.add("nav-hero");
        navbar.classList.remove("nav");
        document.querySelectorAll(".nav-item").forEach((el) => el.classList.remove("nav-select"));
        home.classList.add("nav-select");
      } else { 
        navbar.classList.add("nav");
        navbar.classList.remove("nav-hero");
        document.querySelectorAll(".nav-item").forEach((el) => el.classList.remove("nav-select"));
        about.classList.add("nav-select");
      } 
      });
  </script>
</body>

</html>
