---
import '@fontsource-variable/dm-sans';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
import AltButton from '../components/AltButton.astro';
import Scrolling from '../components/Scrolling.astro';
---
<html>
<head>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <title>RoboZone</title>
  <style>
    @font-face {
      font-family: "Signwood";
      src: url("/fonts/Signwood.ttf"), url("/fonts/SignwoodItalic.ttf");
    }
    body {
      margin: 0;
      width: 100%;
    }

    .home {
      margin-top: 8vh;
      margin-left: 4em;
      margin-right: 1em;
      height: 92vh;
    }

    .about-page {
      text-align: right;
      margin-right: 4em;
      margin-left: 1em;
      margin-top: 5vh;
      height: 90vh;
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
    }

    .about-section {
      text-align: left;
      width: 40vw;
      margin-left: auto;
    }

    .header {
      font-family: "Signwood", sans-serif;
      font-style: italic;
      font-size: min(8vh, 10vw);
      margin-bottom: 35px;
    }

    .content {
      font-family: "DM Sans Variable", sans-serif;
      font-size: min(3vh, 4vw);
    }

    .about-page .content {
      text-align: left;
    }

    .bold {
      font-weight: 800;
    }

    .underlined {
      line-height: 0.1;
      display: inline-block;
      padding: 0px 5px;
      border-bottom: 30px solid #FFD253;
    }

    .blue {
      background: #53C1FF;
    }

    .img {
      width: min(max(30vw, 500px), 80vw);
      box-shadow: 15px 15px 0px #FFD253;
    }

    .about-page .img {
      display: block;
      margin-bottom: 50px;
      width: unset;
      height: 20vw;
    }

    .images {
      margin-left: 8vw;
    }

    .images-2 {
      display: none;
    }

    .img-1 {
      transform: rotate(5deg) translateX(-5vw);
    }

    .img-2 {
      transform: rotate(-3deg) translateX(10vw); 
    }
    
    .buttons {
      width: auto;
    }

    .img-container {
      position: absolute;
      right: 4em;
      text-align: right;
    }

    .img-container .content {
      font-size: min(2vh, 3vw);
      margin-top: 20px;
      text-align: right;
    }

    @media (max-aspect-ratio: 1) {
      .img-container {
        position: relative;
        right: unset;
      }
      .home, .about-page, .about-section {
        margin-left: 1em;
        margin-right: 1em;
        margin-bottom: 11em;
        display: block;
      }
      .about-section {
        width: 100%;
      }
      .about-page .content {
        text-align: center;
      }
      .about-section {
        text-align: center;
      }
      .images {
        display: none;
      }

      .images-2 {
        display: block;
        margin-left: 1em;
        text-align: center;
        width: 100%;
      }
      .img-1 {
        transform: rotate(5deg);
        margin-left: auto;
        margin-right: auto;
        margin-top: 4em;
      }

      .img-2 {
        transform: rotate(-3deg); 
        margin-left: auto;
        margin-right: auto;
      }

      .about-page .img {
        height: 60vw;
      }

      .header, .content {
        text-align: center;
      }
      .buttons {
        display: flex;
        flex-direction: row;
        justify-content: center;
        text-align: center;
        padding: 0 auto;
        width: 100%;
      }
      .img-container .content {
        text-align: center;
      }
      .img-container {
        text-align: center;
        width: 100%;
      }
    }
  </style>
</head>

<body>
  <Navbar/>
  <div class="home">
    <div class="header">Teaching students <Scrolling class="underlined" opts={["robotics.", "engineering.", "programming.", "design."]}>robotics.</Scrolling></div>
    <div class="content">
      Fun, engaging courses from high-school mentors teach students the fundamentals of robotics, engineering, and computer science.
      <br/> <br/>
      RoboZone is available to all 5th to 8th graders, and run at Code Ninjas in Kendall Park.
      <br/> <br/>
      <span class="bold">Only $175 for eight sessions.</span>
    </div>
    <br/>
    <div class="hor-align" style="display: flex; flex-direction: row; flex-wrap: wrap">
      <div class="buttons">
        <Button class="signup">Sign Up</Button>
        <br/> <br/>
        <AltButton>Learn More</AltButton>
      </div>
      <div class="img-container">
        <img class="img" src="/images/a.jpg"/>
        <div class="content">This student built an automatic watering machine for his plants.</div>
      </div>
    </div>
  </div>
  <div class="about-page">
    <div class="images">
      <img class="img img-1" src="/images/work1.jpg"/>
      <img class="img img-2" src="/images/work2.jpg"/>
    </div>
    <div class="about-section">
      <div class="header blue">What is RoboZone?</div>
      <div class="content">
        RoboZone is an organization that runs programs to teach students important computer science, engineering, and robotics principles.
        Our course caters to both beginner and advanced students.
        <br /> <br />
        Students learn how to use breadboards, transistors, capacitors, resistors, and more to create their own projects.
        We teach them how to control these components using Arduinos, which they program in C++.
        <br /> <br />
        Once they have their basics covered, we teach them more advanced topics, like how to control voltage and current,
        and let them design their own project. For their final project, they combine 3D printing, electrical engineering,
        and programming to create anything they wish.
      </div>
    <div class="images images-2">
      <img class="img img-1" src="/images/work1.jpg"/>
      <img class="img img-2" src="/images/work2.jpg"/>
    </div>
    </div>
  </div>


  <!-- JavaScript -->
  <script>
    const signups = document.querySelectorAll(".signup");

    signups.forEach((el) => el.addEventListener("click", () => {
      window.location.href = "/signup";
    }));
  </script>
</body>

</html>
