---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import WorkshopPhoto from "../components/WorkshopPhoto.astro";
import StatStrip from "../components/StatStrip.astro";
import ServoArm from "../components/ServoArm.astro";
import WaysToLearn from "../components/WaysToLearn.astro";
import LearningJourney from "../components/LearningJourney.astro";
import StudentWork from "../components/StudentWork.astro";
import TeamGrid from "../components/TeamGrid.astro";
import Faq from "../components/Faq.astro";
import NextStep from "../components/NextStep.astro";
import { site, fiscalSponsor, faqGeneral, offerings, sessions } from "../data/site";
import { allAvailability, enrollFaq } from "../lib/programs";
import { todayISO } from "../lib/registration";

const siteUrl = (Astro.site ?? new URL(site.url)).href.replace(/\/$/, "");
const a = allAvailability(offerings, sessions, todayISO());
const faqItems = [faqGeneral[0], faqGeneral[1], enrollFaq(a.inPerson, a.online), ...faqGeneral.slice(2)];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: siteUrl,
  logo: `${siteUrl}/images/logo.png`,
  email: site.email,
  description: site.description,
  foundingDate: String(site.founded),
  foundingLocation: { "@type": "Place", name: site.origin },
};
---

<Layout title="RoboZone | Student-led robotics education" description={site.description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        var page = new URLSearchParams(location.search).get("page");
        var to = { about: "/about", support: "/get-involved#support" }[page];
        if (to) location.replace(to);
      })();
    </script>
  </Fragment>

  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="annot">Student-led robotics education</p>
        <h1>Build a circuit. Write the code. See it work.</h1>
        <p class="lede">
          RoboZone is a student-led initiative where younger students learn electronics, programming, and design by
          building real projects. We started with in-person workshops in South Brunswick, New Jersey. Now we're
          planning free online workshops and exploring new local branches.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/program">
            Explore programs
            <Icon name="arrow-right" />
          </a>
          <a class="link-arrow" href="#how-it-works" data-direction="down">
            How we teach
            <Icon name="arrow-down" />
          </a>
        </div>
      </div>

      <WorkshopPhoto
        class="hero__photo"
        photo="ledThumbsUp"
        aspect="5 / 6"
        aspectSm="1 / 1"
        sizes="(min-width: 64rem) 540px, 100vw"
        widths={[480, 720, 1080, 1440]}
        eager
      />
    </div>
  </section>

  <div class="container">
    <StatStrip />
  </div>

  <section class="section" id="programs" aria-labelledby="programs-heading">
    <div class="container">
      <div class="section-head">
        <p class="annot">Programs</p>
        <h2 id="programs-heading">Ways to learn with RoboZone</h2>
        <p>
          Our in-person course is where RoboZone started and what we've taught so far. Free online workshops and local
          branches are how we hope to reach more students. Neither has launched yet.
        </p>
      </div>
      <WaysToLearn />
    </div>
  </section>

  <ServoArm />

  <section class="section section--sunken" id="how-it-works" aria-labelledby="how-heading">
    <div class="container">
      <div class="section-head">
        <p class="annot">How we teach</p>
        <h2 id="how-heading">Each skill builds on the last</h2>
        <p>
          Students don't need to know what a resistor is on day one. In our in-person course they learn by building, one
          working circuit at a time, with mentors at the table to help when something doesn't work.
        </p>
      </div>
      <LearningJourney />
      <p class="journey-more">
        <a class="link-arrow" href="/program#curriculum">
          Every topic in the in-person course
          <Icon name="arrow-right" />
        </a>
      </p>
    </div>
  </section>

  <section class="section section--dark on-dark" id="projects" aria-labelledby="projects-heading">
    <div class="container">
      <div class="section-head">
        <p class="annot">What students make</p>
        <h2 id="projects-heading">Real parts, real code, working builds</h2>
        <p>From our in-person workshops in South Brunswick.</p>
      </div>
      <StudentWork />
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-heading">
    <div class="container people">
      <div class="people__story">
        <p class="annot">Why RoboZone exists</p>
        <h2 id="about-heading">Started by students who learned the hard way</h2>
        <div class="stack measure">
          <p>
            RoboZone's founders taught themselves robotics, electronics, and programming, and found it hard to make
            progress without someone to guide them. In {site.founded} they started RoboZone in South Brunswick to give
            younger students what they had wanted: a structured place to begin.
          </p>
          <p>
            Workshops are taught by high school mentors. Asking questions is expected, and a circuit that doesn't
            light up yet is part of the process. That approach is what we hope to bring to more students.
          </p>
        </div>
        <a class="link-arrow" href="/about">
          About RoboZone and the team
          <Icon name="arrow-right" />
        </a>
      </div>
      <TeamGrid />
    </div>
  </section>

  <section class="section section--sunken" id="get-involved" aria-labelledby="involved-heading">
    <div class="container">
      <div class="section-head">
        <p class="annot">Get involved</p>
        <h2 id="involved-heading">Help more students get started</h2>
      </div>
      <ul role="list" class="paths">
        <li class="paths__item">
          <h3>Mentor</h3>
          <p>Help teach our in-person workshops: explain circuits, look over code, and debug alongside younger students. Our mentors are high school students.</p>
          <a class="link-arrow" href="/get-involved#mentor">Mentoring <Icon name="arrow-right" /></a>
        </li>
        <li class="paths__item">
          <h3>Host or partner</h3>
          <p>Host workshops near South Brunswick, or talk with us about a possible RoboZone program in your own community.</p>
          <a class="link-arrow" href="/get-involved#partner">Hosting and partnering <Icon name="arrow-right" /></a>
        </li>
        <li class="paths__item">
          <h3>Donate</h3>
          <p>{fiscalSponsor.statement} Donations go through HCB, Hack Club's donation platform.</p>
          <a class="link-arrow" href="/get-involved#support">How donations work <Icon name="arrow-right" /></a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-heading">
    <div class="container faq-layout">
      <div class="section-head faq-layout__head">
        <p class="annot">Questions</p>
        <h2 id="faq-heading">Common questions</h2>
        <p>
          Questions about the in-person course are on the <a href="/program#faq">Programs page</a>. Can't find your
          answer? Email <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
      <Faq items={faqItems} />
    </div>
    <div class="container next-wrap">
      <NextStep />
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .hero__text {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .hero h1 {
    max-width: 13ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-2);
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .hero :global(.photo__frame) {
      aspect-ratio: 1 / 1;
    }
  }

  @media (min-width: 64rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .journey-more {
    margin-top: var(--space-6);
    padding-left: calc(2.25rem + var(--space-4));
  }

  .people {
    display: grid;
    gap: var(--space-7);
  }

  .people__story {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  @media (min-width: 64rem) {
    .people {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: var(--space-8);
      align-items: center;
    }
  }

  .paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 2px solid var(--color-text);
  }

  .paths__item {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-5) var(--space-4) 0;
  }

  .paths__item + .paths__item {
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-border);
  }

  .paths__item p {
    color: var(--color-text-muted);
  }

  @media (max-width: 52rem) {
    .paths {
      grid-template-columns: 1fr;
    }

    .paths__item,
    .paths__item + .paths__item {
      padding: var(--space-5) 0 var(--space-3);
      border-left: 0;
    }

    .paths__item + .paths__item {
      border-top: 1px solid var(--color-border);
    }
  }

  .faq-layout {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 64rem) {
    .faq-layout {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-8);
      align-items: start;
    }

    .faq-layout__head {
      margin-bottom: 0;
    }
  }

  .next-wrap {
    margin-top: var(--space-8);
  }
</style>
