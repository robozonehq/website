---
import '@fontsource-variable/dm-sans';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
import AltButton from '../components/AltButton.astro';
import Scrolling from '../components/Scrolling.astro';
---
<html>
<head>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <title>RoboZone</title>
  <style>
    @font-face {
      font-family: "Signwood";
      src: url("/fonts/Signwood.ttf"), url("/fonts/SignwoodItalic.ttf");
    }
    body {
      margin: 0;
      width: 100%;
    }
    .home {
      margin-top: 8vh;
      margin-left: 4em;
      margin-right: 1em;
    }

    .header {
      font-family: "Signwood", sans-serif;
      font-style: italic;
      font-size: min(8vh, 10vw);
      margin-bottom: 35px;
    }

    .content {
      font-family: "DM Sans Variable", sans-serif;
      font-size: min(3vh, 4vw);
    }

    .bold {
      font-weight: 800;
    }

    .underlined {
      line-height: 0.1;
      display: inline-block;
      padding: 0px 5px;
      border-bottom: 30px solid #FFD253;
    }

    .img {
      width: min(max(30vw, 500px), 80vw);
      box-shadow: 15px 15px 0px #FFD253;
    }
    
    .buttons {
      width: auto;
    }

    .img-container {
      position: absolute;
      right: 4em;
      text-align: right;
    }

    .img-container .content {
      font-size: min(2vh, 3vw);
      margin-top: 20px;
      text-align: right;
    }

    @media (max-aspect-ratio: 1) {
      .img-container {
        position: relative;
        right: unset;
      }
      .home {
        margin-left: 1em;
        margin-right: 1em;
      }
    }
    @media (max-aspect-ratio: 3/4) {
      .img {
        width: 70vw;
      }
      .header, .content {
        text-align: center;
      }
      .buttons {
        display: flex;
        flex-direction: row;
        justify-content: center;
        text-align: center;
        padding: 0 auto;
        width: 100%;
      }
      .img-container .content {
        text-align: center;
      }
      .img-container {
        text-align: center;
        width: 100%;
      }
    }
  </style>
</head>

<body>
  <Navbar/>
  <div class="home">
    <div class="header">Teaching students <Scrolling class="underlined" opts={["robotics.", "engineering.", "programming.", "design."]}>robotics.</Scrolling></div>
    <div class="content">
      Fun, engaging courses from high-school mentors teach students the fundamentals of robotics, engineering, and computer science.
      <br/> <br/>
      RoboZone is available to all 5th to 8th graders, and run at Code Ninjas in Kendall Park.
      <br/> <br/>
      <span class="bold">Only $175 for eight sessions.</span>
    </div>
    <br/>
    <div class="hor-align" style="display: flex; flex-direction: row; flex-wrap: wrap">
      <div class="buttons">
        <Button>Sign Up</Button>
        <br/> <br/>
        <AltButton>Learn More</AltButton>
      </div>
      <div class="img-container">
        <img class="img" src="/images/a.jpg"/>
        <div class="content">This student built an automatic water machine for his plants.</div>
      </div>
    </div>
  </div>


  <!-- JavaScript -->
  <script>
    import createScrollSnap from 'scroll-snap';
    const element = document.body;
    const home = document.querySelector(".home");
    const about = document.querySelector(".about");
    const support = document.querySelector(".support");
    const hero = document.querySelector('.hero'); 
    const aboutSection = document.querySelector(".about-section");
    const teamSection = document.querySelector(".team-section");
    const navbar = document.querySelector('.navbar'); 
    const signup = document.querySelectorAll('.signup');
    const params = new URLSearchParams(window.location.search);

    /* NAVIGATION FUNCTIONS */
    const navHero = () => {
      navbar.classList.add("nav-hero");
      navbar.classList.remove("nav");
      document.querySelectorAll(".nav-item").forEach((el) => el.classList.remove("nav-select"));
      home.classList.add("nav-select");
      history.replaceState({}, "home", "/");
    };
    const navAbout = () => {
      navbar.classList.add("nav");
      navbar.classList.remove("nav-hero");
      document.querySelectorAll(".nav-item").forEach((el) => el.classList.remove("nav-select"));
      about.classList.add("nav-select");
      history.replaceState({}, "about", "/?page=about");
    };

    const navSupport = () => {
      navbar.classList.add("nav");
      navbar.classList.remove("nav-hero");
      document.querySelectorAll(".nav-item").forEach((el) => el.classList.remove("nav-select"));
      support.classList.add("nav-select");
      history.replaceState({}, "support", "/?page=support");
    };

    /* EVENT LISTENERS */
    home.addEventListener("click", () => {
      hero.scrollIntoView({ behavior: "smooth" });
      navUpdate();
    });

    about.addEventListener("click", () => {
      aboutSection.scrollIntoView({ behavior: "smooth" });
      navAbout();
    });

    support.addEventListener("click", () => {
      document.querySelector(".support-section").scrollIntoView({ behavior: "smooth" });
      navSupport();
    });

    signup.forEach((el) => el.addEventListener("click", () => {
      window.location.href = "/signup";
    }));
    document.querySelector(".btn-donate").addEventListener("click", () => {
      window.location.href = "https://hcb.hackclub.com/donations/start/robozone";
    });

    // Paging logic

    if (params.has('page')) {
      const page = params.get('page');
      if (page == "about") {
        aboutSection.scrollIntoView({ behavior: "smooth" });
        navAbout();
      } else if (page == "support") {
        document.querySelector(".support-section").scrollIntoView({ behavior: "smooth" });
        navSupport();
      }
    }

  </script>
</body>

</html>
