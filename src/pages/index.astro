---
import "@fontsource-variable/dm-sans";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="RoboZone - Robotics Education">
    <Navbar />

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <h1>Teach your child <span class="accent">robotics</span></h1>
                <p>
                    Fun, engaging courses from high-school mentors teach
                    students the fundamentals of robotics, engineering, and
                    computer science.
                </p>
                <div class="hero-cta">
                    <a href="/signup" class="btn btn-primary">Sign Up</a>
                    <a href="#about" class="btn btn-secondary">Learn More</a>
                </div>
                <div class="hero-details">
                    <div class="hero-detail">
                        <span class="detail-icon">👨‍👩‍👧‍👦</span>
                        <span>For 5th-8th graders</span>
                    </div>
                    <div class="hero-detail">
                        <span class="detail-icon">📍</span>
                        <span>Code Ninjas, Kendall Park</span>
                    </div>
                    <div class="hero-detail">
                        <span class="detail-icon">💰</span>
                        <span>Only $175 for eight classes</span>
                    </div>
                </div>
            </div>
            <div class="hero-image">
                <img src="/images/a.jpg" alt="Student's robotics project" />
                <div class="image-caption">
                    A student's automatic plant watering machine
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="container">
            <h2 class="section-title">
                What is <span class="accent-blue">RoboZone</span>?
            </h2>
            <div class="about-content">
                <div class="about-text">
                    <p>
                        RoboZone is an organization that runs programs to teach
                        students important computer science, engineering, and
                        robotics principles. Our course caters to both beginner
                        and advanced students.
                    </p>
                    <p>
                        Students learn how to use breadboards, transistors,
                        capacitors, resistors, and more to create their own
                        projects. We teach them how to control these components
                        using Arduinos, which they program in C++.
                    </p>
                    <p>
                        Once they have their basics covered, we teach them more
                        advanced topics, like how to control voltage and
                        current, and let them design their own project. For
                        their final project, they combine 3D printing,
                        electrical engineering, and programming to create
                        anything they wish.
                    </p>
                </div>
                <div class="about-images">
                    <img
                        src="/images/work1.jpg"
                        alt="Students working on robotics"
                        class="about-img"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features">
        <div class="container">
            <h2 class="section-title text-center">What Students Will Learn</h2>
            <div class="feature-grid">
                <div class="feature">
                    <div class="feature-icon text-center">💡</div>
                    <h3>Electronics</h3>
                    <p>
                        Learn to work with electronic components and understand
                        circuit design.
                    </p>
                </div>
                <div class="feature">
                    <div class="feature-icon">💻</div>
                    <h3>Programming</h3>
                    <p>
                        Write code in C++ to control Arduino boards and create
                        interactive projects.
                    </p>
                </div>
                <div class="feature">
                    <div class="feature-icon">🤖</div>
                    <h3>Robotics</h3>
                    <p>
                        Build robots and automated systems that interact with
                        the real world.
                    </p>
                </div>
                <div class="feature">
                    <div class="feature-icon">🔧</div>
                    <h3>Engineering</h3>
                    <p>
                        Apply engineering principles to solve real-world
                        problems with technology.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Team Section -->
    <section class="team">
        <div class="container">
            <h2 class="section-title team-title">
                Meet Our <span style="color: white;">Team</span>
            </h2>
            <div class="team-grid">
                <div class="team-member">
                    <div class="member-image">
                        <img src="/images/daksh.png" alt="Daksh - President" />
                    </div>
                    <h3>Daksh Gupta</h3>
                    <div class="member-title">President</div>
                    <p>
                        Daksh is a rising junior at South Brunswick High School.
                        He is a member of VEX robotics team 750W. In his free
                        time, Daksh enjoys working on computer science projects
                        and spending time with friends, dogs and family.
                    </p>
                </div>
                <div class="team-member">
                    <div class="member-image">
                        <img
                            src="/images/sammy.png"
                            alt="Sammy - Vice President"
                        />
                    </div>
                    <h3>Samuel Asefa</h3>
                    <div class="member-title">Vice-President</div>
                    <p>
                        Sammy is a rising junior at South Brunswick High School
                        and is a part of his VEX robotics team, 750W. In his
                        free time he enjoys competing in Science Olympiad and
                        spending time with his family, friends, and two cats.
                    </p>
                </div>
                <div class="team-member">
                    <div class="member-image">
                        <img
                            src="/images/nitish.png"
                            alt="Nitish - Secretary"
                        />
                    </div>
                    <h3>Nitish Pendyala</h3>
                    <div class="member-title">Secretary</div>
                    <p>
                        Nitish is a rising junior at South Brunswick High School
                        that is a part of his VEX robotics team. In his free
                        time he enjoys playing volleyball and outdoor activities
                        like hiking and camping.
                    </p>
                </div>
                <div class="team-member">
                    <div class="member-image">
                        <img
                            src="/images/rohan.png"
                            alt="Rohan - Operations Manager"
                        />
                    </div>
                    <h3>Rohan Kunala</h3>
                    <div class="member-title">Operations Manager</div>
                    <p>
                        Rohan is a rising junior at SBHS. He is a part of
                        multiple clubs and organizations related to the STEM
                        area. In his free time Rohan enjoys partaking in
                        innovation research competitions. He enjoys spending
                        time with his family and friends by traveling and
                        camping.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta">
        <div class="container">
            <div class="cta-content">
                <h2>Ready to get started?</h2>
                <p>
                    Join our next session and help your child discover the
                    exciting world of robotics and programming.
                </p>
                <a href="/signup" class="btn btn-primary btn-large"
                    >Sign Up Now</a
                >
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-logo">RoboZone</div>
                <div class="footer-info">
                    <p>
                        &copy; {new Date().getFullYear()} RoboZone. All rights reserved.
                    </p>
                </div>
            </div>
        </div>
    </footer>
</Layout>

<style>
    /* Font settings */
    @font-face {
        font-family: "Signwood";
        src: url("/fonts/Signwood.ttf"), url("/fonts/SignwoodItalic.ttf");
        font-display: swap;
    }

    /* Variables */
    :root {
        --primary: #53c1ff;
        --secondary: #ffd253;
        --dark: #000000;
        --white: #ffffff;
        --gray-light: #f8f9fa;
        --gray: #e9ecef;
        --gray-dark: #495057;
        --body-font: "DM Sans Variable", sans-serif;
        --heading-font: "Signwood", sans-serif;
    }

    /* Reset and base styles */
    *,
    *::before,
    *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: var(--body-font);
        line-height: 1.6;
        color: var(--gray-dark);
        background-color: var(--white);
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    img {
        max-width: 100%;
        display: block;
    }

    /* Layout */
    .container {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* Hero Section Starts Here */

    /* Hero Section */
    .hero {
        padding: 80px 0 30px;
        overflow: hidden;
    }

    .hero .container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: center;
    }

    .hero-content h1 {
        font-family: var(--heading-font);
        font-style: italic;
        font-size: 48px;
        line-height: 1.2;
        margin-bottom: 20px;
        color: var(--dark);
    }

    .accent {
        color: var(--secondary);
    }

    .accent-blue {
        color: var(--primary);
    }

    .hero-content p {
        font-size: 18px;
        margin-bottom: 30px;
        max-width: 90%;
    }

    .hero-cta {
        display: flex;
        gap: 15px;
        margin-bottom: 30px;
    }

    .btn {
        font-family: var(--heading-font);
        font-style: italic;
        padding: 5px 15px;
        border-radius: 0;
        font-size: 22px;
        transition: all 0.3s ease;
        display: inline-block;
    }

    .btn-primary {
        background-color: var(--dark);
        color: var(--white);
        box-shadow: 4px 4px 0 var(--secondary);
    }

    .btn-secondary {
        background-color: var(--secondary);
        color: var(--dark);
        box-shadow: 4px 4px 0 var(--dark);
    }

    .btn:hover {
        transform: translate(-2px, -2px);
        box-shadow: 6px 6px 0 var(--secondary);
    }

    .btn-secondary:hover {
        box-shadow: 6px 6px 0 var(--dark);
    }

    .btn-large {
        padding: 7px 20px;
        font-size: 24px;
    }

    .hero-details {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .hero-detail {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 16px;
    }

    .detail-icon {
        font-size: 20px;
    }

    .hero-image {
        position: relative;
    }

    .hero-image img {
        width: 100%;
        border-radius: 0;
        box-shadow: 10px 10px 0 var(--secondary);
        transition: all 0.3s ease;
    }

    .hero-image img:hover {
        transform: translate(-5px, -5px);
        box-shadow: 15px 15px 0 var(--secondary);
    }

    .image-caption {
        margin-top: 15px;
        font-size: 14px;
        color: var(--gray-dark);
        text-align: center;
    }

    /* About Section */
    .about {
        padding: 20px 0;
        background-color: var(--gray-light);
    }

    .section-title {
        font-family: var(--heading-font);
        font-style: italic;
        font-size: 48px;
        text-align: center;
        margin-bottom: 15px;
        color: var(--dark);
    }

    .about-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: center;
    }

    .about-text p {
        margin-bottom: 20px;
        font-size: 16px;
    }

    .about-images {
        padding: 20px 0;
        display: flex;
        justify-content: center;
    }

    .about-img {
        width: 100%;
        max-height: 400px;
        object-fit: cover;
        border-radius: 0;
        box-shadow: 8px 8px 0 var(--secondary);
        transition: all 0.3s ease;
    }

    .about-img:hover {
        transform: translate(-5px, -5px);
        box-shadow: 13px 13px 0 var(--secondary);
    }

    /* Features Section */
    .features {
        padding: 20px 0;
    }

    /* Team Section */
    .team {
        padding: 20px 0;
        background-color: var(--secondary);
    }

    .team-title {
        color: var(--dark);
    }

    .team-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px;
        margin-top: 30px;
    }

    .team-member {
        background-color: var(--white);
        padding: 20px;
        border-radius: 0;
        text-align: center;
        box-shadow: 5px 5px 0 var(--dark);
        transition: all 0.3s ease;
    }

    .team-member:hover {
        transform: translateY(-10px);
        box-shadow: 8px 8px 0 var(--dark);
    }

    .member-image {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        overflow: hidden;
        margin: 0 auto 15px;
        border: 3px solid var(--dark);
    }

    .member-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .team-member h3 {
        font-family: var(--heading-font);
        font-style: italic;
        font-size: 24px;
        margin-bottom: 5px;
        color: var(--dark);
    }

    .member-title {
        color: var(--dark);
        font-weight: bold;
        margin-bottom: 10px;
    }

    .team-member p {
        font-size: 14px;
        color: var(--gray-dark);
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .feature {
        background-color: var(--white);
        border-radius: 0;
        padding: 20px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        text-align: center;
    }

    .feature:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
    }

    .feature-icon {
        font-size: 40px;
        margin: 0 auto 20px;
        display: flex;
        justify-content: center;
    }

    .feature h3 {
        font-family: var(--heading-font);
        font-style: italic;
        font-size: 24px;
        margin-bottom: 15px;
        color: var(--dark);
    }

    .feature p {
        font-size: 16px;
        color: var(--gray-dark);
    }

    /* CTA Section */
    .cta {
        background-color: var(--primary);
        padding: 25px 0;
        text-align: center;
        color: var(--white);
    }

    .cta-content {
        max-width: 700px;
        margin: 0 auto;
    }

    .cta h2 {
        font-family: var(--heading-font);
        font-style: italic;
        font-size: 36px;
        margin-bottom: 10px;
    }

    .cta p {
        font-size: 18px;
        margin-bottom: 15px;
    }

    /* Footer */
    .footer {
        background-color: var(--dark);
        color: var(--white);
        padding: 15px 0;
    }

    .footer-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 10px;
    }

    .footer-logo {
        font-family: var(--heading-font);
        font-style: italic;
        font-size: 24px;
    }

    .footer-info {
        font-size: 14px;
    }

    /* Responsive */
    @media (max-width: 900px) {
        .hero .container,
        .about-content {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .hero-content p {
            max-width: 100%;
        }

        .hero-cta {
            justify-content: center;
        }

        .hero-details {
            max-width: 400px;
            margin: 0 auto;
        }

        .hero-image {
            margin-top: 30px;
            order: 2;
        }

        .about-text {
            order: 2;
        }

        .about-images {
            order: 1;
            margin-bottom: 40px;
        }

        .about-img {
            max-width: 90%;
            max-height: 300px;
        }
    }

    @media (max-width: 900px) {
        .team-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 600px) {
        .hero {
            padding: 80px 0 30px;
        }

        .hero-content h1 {
            font-size: 36px;
        }

        .hero-content p {
            font-size: 16px;
        }

        .hero-cta {
            flex-direction: column;
            gap: 10px;
        }

        .about-images {
            padding: 10px 0;
        }

        .section-title,
        .cta h2 {
            font-size: 30px;
        }

        .feature-grid {
            grid-template-columns: 1fr;
        }

        .team-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .member-image {
            width: 120px;
            height: 120px;
        }
    }
</style>

<script>
    // Empty script - navbar functionality is now in the Navbar component
</script>
