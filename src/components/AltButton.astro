---
interface Props {
    class?: string;
    color?: "primary" | "secondary" | "accent" | "dark" | string;
    variant?: "filled" | "outline";
    size?: "small" | "medium" | "large";
    href?: string;
    type?: "button" | "submit" | "reset";
}

const {
    class: className,
    color = "secondary",
    variant = "filled",
    size = "medium",
    href,
    type,
    ...rest
} = Astro.props;

// Map color names to CSS variables
const colorMap: Record<string, string> = {
    primary: "var(--primary)",
    secondary: "var(--secondary)",
    accent: "var(--accent)",
    dark: "var(--dark)",
};

// Use the mapped color or the raw value if not in map
const buttonColor = colorMap[color] || color;

// Compute component: button or anchor
const Component = href ? "a" : "button";
---

<style define:vars={{ buttonColor }}>
    .btn {
        font-family: "Signwood", sans-serif;
        font-style: italic;
        display: inline-block;
        padding: 0.5rem 1.75rem;
        background: var(--buttonColor);
        border: none;
        box-shadow: 5px 5px 0px var(--dark);
        transition: all 0.2s ease;
        color: black;
        cursor: pointer;
        text-align: center;
        font-size: 1.25rem;
        line-height: 1.2;
    }

    .btn-sm {
        padding: 0.35rem 1.25rem;
        font-size: 1rem;
        box-shadow: 3px 3px 0px var(--dark);
    }

    .btn-lg {
        padding: 0.65rem 2.25rem;
        font-size: 1.5rem;
        box-shadow: 7px 7px 0px var(--dark);
    }

    .btn-outline {
        background: transparent;
        border: 2px solid var(--buttonColor);
        color: var(--buttonColor);
        box-shadow: 5px 5px 0px var(--buttonColor);
    }

    .btn:hover {
        box-shadow: 8px 8px 0px var(--dark);
        transform: translate(-2px, -2px);
    }

    .btn:active {
        box-shadow: 2px 2px 0px var(--dark);
        transform: translate(2px, 2px);
    }

    /* Active state styling */
    .btn-active {
        background: var(--dark);
        color: white;
        box-shadow: 5px 5px 0px var(--buttonColor);
    }

    .btn-active:hover {
        box-shadow: 8px 8px 0px var(--buttonColor);
    }

    .btn-active:active {
        box-shadow: 2px 2px 0px var(--buttonColor);
    }

    @media (max-width: 768px) {
        .btn {
            padding: 0.45rem 1.5rem;
        }
    }
</style>

<Component
    class:list={[
        "btn",
        size === "small" ? "btn-sm" : size === "large" ? "btn-lg" : "",
        variant === "outline" ? "btn-outline" : "",
        className,
    ]}
    href={href}
    type={type}
    {...rest}
>
    <slot />
</Component>
