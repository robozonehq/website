---
import Icon from "./Icon.astro";
import { offerings, sessions, mailto, site } from "../data/site";
import { allAvailability, headerCta } from "../lib/programs";
import { todayISO } from "../lib/registration";

interface Props {
  showProgramsLink?: boolean;
}

const { showProgramsLink = true } = Astro.props;
const a = allAvailability(offerings, sessions, todayISO());
const open = a.inPerson.registrable ?? a.online.registrable;
const cta = headerCta(a.inPerson, a.online);
---

<section class="next" aria-labelledby="next-heading">
  <div class="next__text">
    {
      open ? (
        <>
          <h2 id="next-heading">Registration is open: {open.name}</h2>
          <p>
            {open.dates}, {open.schedule}. Check the details and fee before you register.
          </p>
        </>
      ) : (
        <>
          <h2 id="next-heading">Find the right next step</h2>
          <p>
            See where each program stands, or ask us about future in-person sessions, online classes, mentoring, or a
            program in your community.
          </p>
        </>
      )
    }
  </div>
  <div class="next__actions">
    <a class="btn btn--primary" href={cta.href}>
      {open ? `Register for ${open.name}` : cta.label}
      <Icon name="arrow-right" />
    </a>
    <a class="link-arrow" href={mailto()}>
      <Icon name="mail" />
      {site.email}
    </a>
    {
      showProgramsLink && (
        <a class="link-arrow" href="/program">
          All programs <Icon name="arrow-right" />
        </a>
      )
    }
  </div>
</section>

<style>
  .next {
    display: grid;
    gap: var(--space-5) var(--space-7);
    align-items: center;
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    background-color: var(--brand-sky-tint);
    background-image: radial-gradient(circle, rgb(11 95 191 / 0.16) 1.3px, transparent 1.5px);
    background-size: 16px 16px;
    border: 1px solid #b7dcf5;
    border-radius: var(--radius-lg);
  }

  .next__text {
    display: grid;
    gap: var(--space-3);
    max-width: 40rem;
  }

  .next h2 {
    font-size: clamp(1.625rem, 1.3rem + 1.4vw, 2.375rem);
  }

  .next p {
    font-size: var(--text-lg);
    color: var(--color-text);
  }

  .next__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }

  .next__actions .btn {
    white-space: normal;
  }

  @media (min-width: 64rem) {
    .next {
      grid-template-columns: minmax(0, 1.4fr) auto;
    }

    .next__actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
