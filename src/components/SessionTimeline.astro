---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import { sessionHistory, offerings, sessions } from "../data/site";
import { photos } from "../data/photos";
import { availabilityFor } from "../lib/programs";
import { todayISO } from "../lib/registration";

const next = availabilityFor(offerings["in-person"], sessions, todayISO());
---

<ol role="list" class="timeline">
  {
    sessionHistory.map((item) => {
      const p = photos[item.photo];
      return (
        <li class="timeline__item">
          <span class="timeline__pad" aria-hidden="true" />
          <p class="annot annot--plain">{item.season}</p>
          <h3>{item.title}</h3>
          <p class="timeline__venue">
            <Icon name="pin" />
            {item.venue}
          </p>
          <figure class="timeline__photo">
            <div class="timeline__frame">
              <Picture
                src={p.src}
                alt={p.alt}
                widths={[360, 560, 800]}
                width={800}
                sizes="(min-width: 64rem) 270px, (min-width: 40rem) 45vw, 90vw"
                formats={["avif", "webp"]}
                fallbackFormat="jpg"
                quality={72}
                loading="lazy"
                style={`object-position:${p.position ?? "50% 50%"}`}
              />
            </div>
            <figcaption>{p.caption}</figcaption>
          </figure>
        </li>
      );
    })
  }
  <li class="timeline__item timeline__item--next">
    <span class="timeline__pad" aria-hidden="true" />
    <p class="annot annot--plain">Next</p>
    <h3>{next.registrable ? next.registrable.name : next.state === "upcoming" && next.session ? next.session.name : "Not scheduled yet"}</h3>
    <p class="timeline__venue">
      <Icon name="pin" />
      {next.session?.location ?? "Location announced with the dates"}
    </p>
    <a class="link-arrow" href="/signup">Program updates <Icon name="arrow-right" /></a>
  </li>
</ol>

<style>
  .timeline {
    --pad: 1.375rem;
    --col-gap: var(--space-5);
    --row-gap: var(--space-6);
    --trace: var(--brand-blue);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--row-gap) var(--col-gap);
  }

  .timeline__item {
    position: relative;
    display: grid;
    gap: var(--space-2);
    align-content: start;
    justify-items: start;
  }

  .timeline__item:not(:last-child)::after {
    content: "";
    position: absolute;
    top: calc(var(--pad) / 2 - 1.5px);
    left: calc(var(--pad) / 2);
    width: calc(100% + var(--col-gap));
    height: 3px;
    background: var(--trace);
    border-radius: 2px;
  }

  .timeline__item:nth-last-child(2)::after {
    background: repeating-linear-gradient(90deg, var(--trace) 0 7px, transparent 7px 12px);
  }

  .timeline__pad {
    position: relative;
    z-index: 1;
    display: block;
    width: var(--pad);
    height: var(--pad);
    margin-bottom: var(--space-3);
    background: radial-gradient(circle, var(--color-bg) 0 3px, var(--color-text) 3.5px 4.5px, transparent 5px),
      var(--brand-yellow);
    border: 2px solid var(--color-text);
    border-radius: 4px;
  }

  .timeline__item--next .timeline__pad {
    background: var(--color-bg);
    border-style: dashed;
  }

  .timeline h3 {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }

  .timeline__venue {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .timeline__venue svg {
    width: 1rem;
    height: 1rem;
    color: var(--brand-blue);
    flex: none;
  }

  .timeline__photo {
    display: grid;
    gap: var(--space-2);
    width: 100%;
    margin-top: var(--space-3);
  }

  .timeline__frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface-sunken);
  }

  .timeline__frame :global(picture) {
    display: contents;
  }

  .timeline__frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .timeline__photo figcaption {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .timeline__item--next .link-arrow {
    margin-top: var(--space-1);
  }

  @media (max-width: 64rem) {
    .timeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .timeline__item::after {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .timeline {
      --row-gap: var(--space-7);
      --rail: calc(var(--pad) + var(--space-4));
      grid-template-columns: 1fr;
      padding-left: var(--rail);
    }

    .timeline__pad {
      position: absolute;
      left: calc(var(--rail) * -1);
      top: 0;
      margin: 0;
    }

    .timeline__item:not(:last-child)::after {
      display: block;
      top: calc(var(--pad) / 2);
      left: calc(var(--rail) * -1 + var(--pad) / 2 - 1.5px);
      width: 3px;
      height: calc(100% + var(--row-gap));
    }

    .timeline__item:nth-last-child(2)::after {
      background: repeating-linear-gradient(180deg, var(--trace) 0 7px, transparent 7px 12px);
    }
  }
</style>
