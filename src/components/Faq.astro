---
import type { FaqItem } from "../data/site";

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq__item">
        <summary>
          <span>{item.q}</span>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--color-border);
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 56px;
    padding-block: var(--space-4);
    font-size: 1.0625rem;
    font-weight: 650;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover span:first-child {
    color: var(--color-link);
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.75rem;
    height: 2px;
    background: currentColor;
    translate: -50% -50%;
    transition: rotate var(--duration) var(--ease);
  }

  .faq__icon::after {
    rotate: 90deg;
  }

  details[open] .faq__icon::after {
    rotate: 0deg;
  }

  .faq__item p {
    max-width: var(--measure);
    padding-bottom: var(--space-5);
    color: var(--color-text-muted);
  }
</style>
