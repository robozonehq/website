---
interface Props {
    class?: string;
    opts: string[];
}
const { class: className, opts, ...rest } = Astro.props;
---

<style>
    .scroll-container {
        display: inline-block;
        position: relative;
    }

    .scroll-text {
        display: inline-block;
        position: absolute;
        top: 0;
        left: 0;
        opacity: 0;
        transform: translateY(10px);
    }

    .scroll-text.active {
        position: relative;
        opacity: 1;
        transform: translateY(0);
        transition:
            opacity 0.3s ease,
            transform 0.3s ease;
    }

    .scroll-text.exit {
        opacity: 0;
        transform: translateY(-10px);
        transition:
            opacity 0.3s ease,
            transform 0.3s ease;
    }

    .spacer {
        visibility: hidden;
        display: inline-block;
    }
</style>

<span
    class:list={["scroll-container", className]}
    {...rest}
    data-opts={JSON.stringify(opts)}
>
    <span class="spacer">{opts[0]}</span>
    <span class="scroll-text active" aria-live="polite">{opts[0]}</span>
</span>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const scrollContainers = document.querySelectorAll(".scroll-container");

        scrollContainers.forEach((container) => {
            const containerElement = container as HTMLElement;
            if (!containerElement.dataset.opts) return;

            try {
                const options = JSON.parse(containerElement.dataset.opts);
                if (!Array.isArray(options) || options.length === 0) return;

                let currentIndex = 0;
                let activeElement = containerElement.querySelector(
                    ".scroll-text.active",
                );
                const spacer = containerElement.querySelector(".spacer");

                // Ensure the spacer is wide enough for the longest option
                function updateSpacer() {
                    if (spacer) {
                        let maxWidth = 0;
                        let widestText = options[0];

                        // Find the widest text
                        options.forEach((text) => {
                            spacer.textContent = text;
                            const spacerElement = spacer as HTMLElement;
                            const width = spacerElement.offsetWidth;
                            if (width > maxWidth) {
                                maxWidth = width;
                                widestText = text;
                            }
                        });

                        // Set the spacer to the widest text
                        spacer.textContent = widestText;
                    }
                }

                updateSpacer();

                const rotateText = () => {
                    // Get next index
                    currentIndex = (currentIndex + 1) % options.length;

                    // Mark current element for exit
                    if (activeElement) {
                        activeElement.classList.remove("active");
                        activeElement.classList.add("exit");
                    }

                    // Create new element
                    const newElement = document.createElement("span");
                    newElement.className = "scroll-text";
                    newElement.textContent = options[currentIndex];
                    container.appendChild(newElement);

                    // Trigger reflow for animation
                    void newElement.offsetWidth;

                    // Add active class
                    newElement.classList.add("active");

                    // Remove old element after animation completes
                    setTimeout(() => {
                        if (activeElement && activeElement.parentNode) {
                            activeElement.remove();
                        }
                        activeElement = newElement;
                    }, 300);
                };

                // Start rotation
                setInterval(rotateText, 3000);
            } catch (error) {
                console.error("Error parsing scroll options:", error);
            }
        });
    });
</script>
