---
import { maturityLabel } from "../data/site";
import type { Availability } from "../lib/programs";

interface Props {
  availability: Availability;
  class?: string;
}

const { availability, class: className } = Astro.props;
const maturity = availability.offering.maturity;
---

<p class:list={["pstatus", className]} data-maturity={maturity} data-state={availability.state}>
  <span class="pstatus__maturity">
    <span class="pstatus__mark" aria-hidden="true"></span>
    {maturityLabel[maturity]}
  </span>
  <span class="pstatus__sep" aria-hidden="true">/</span>
  <span class="pstatus__avail">{availability.statusText}</span>
</p>

<style>
  .pstatus {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .pstatus__maturity {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--color-text);
  }

  .pstatus__mark {
    width: 0.7em;
    height: 0.7em;
    flex: none;
    border: 1.5px solid var(--color-text);
    background: var(--brand-yellow);
  }

  [data-maturity="exploring"] .pstatus__mark {
    background: transparent;
    border-style: dashed;
  }

  [data-maturity="in-development"] .pstatus__mark {
    background: linear-gradient(90deg, var(--brand-yellow) 50%, transparent 50%);
  }

  [data-maturity="retired"] .pstatus__mark {
    background: var(--color-border);
    border-color: var(--color-text-muted);
  }

  .pstatus__sep {
    color: var(--color-border-strong);
  }

  [data-state="open"] .pstatus__avail {
    color: var(--color-success);
    font-weight: 600;
  }

  :global(.on-dark) .pstatus,
  :global(.on-dark) .pstatus__maturity {
    color: var(--color-dark-text);
  }

  :global(.on-dark) .pstatus__mark {
    border-color: var(--color-dark-text);
  }
</style>
