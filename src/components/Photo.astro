---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  label?: string;
  aspect?: string;
  aspectSm?: string;
  position?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  caption,
  label,
  aspect = "4 / 3",
  aspectSm,
  position = "50% 50%",
  sizes = "(min-width: 75rem) 600px, (min-width: 52rem) 50vw, 100vw",
  widths = [480, 720, 960, 1280],
  eager = false,
  class: className,
} = Astro.props;

const usableWidths = widths.filter((w) => w <= src.width);
const srcsetWidths = usableWidths.length ? usableWidths : [src.width];
const fallbackWidth = Math.max(...srcsetWidths);
---

<figure class:list={["photo", className]} style={`--ar:${aspect};--ar-sm:${aspectSm ?? aspect}`}>
  <div class="frame photo__frame">
    <Picture
      src={src}
      alt={alt}
      widths={srcsetWidths}
      width={fallbackWidth}
      sizes={sizes}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      quality={72}
      loading={eager ? "eager" : "lazy"}
      decoding={eager ? "sync" : "async"}
      fetchpriority={eager ? "high" : undefined}
      style={`object-position:${position}`}
    />
  </div>
  {
    (caption || label) && (
      <figcaption class="photo__caption">
        {label && <span class="annot">{label}</span>}
        {caption && <span>{caption}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .photo {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  .photo__frame {
    aspect-ratio: var(--ar-sm);
  }

  @media (min-width: 40rem) {
    .photo__frame {
      aspect-ratio: var(--ar);
    }
  }

  .photo__frame :global(picture) {
    display: contents;
  }

  .photo__caption {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  :global(.on-dark) .photo__caption {
    color: var(--color-dark-muted);
  }
</style>
