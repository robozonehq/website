---
import Icon from "./Icon.astro";
import type { RegistrableSession } from "../lib/programs";
import { site, mailto, offerings } from "../data/site";
import { ordinal } from "../lib/registration";

interface Props {
  session: RegistrableSession;
}

const { session } = Astro.props;
const pbUrl = import.meta.env.PUBLIC_POCKETBASE_URL || "https://robozonenj.org/admin";
---

<div
  class="signup"
  data-pb-url={pbUrl}
  data-closes={session.registrationCloses}
  data-grades={JSON.stringify(session.grades)}
>
  <form id="signup-form" class="signup__form" novalidate aria-labelledby="form-heading">
    <div class="signup__intro">
      <h2 id="form-heading">Student and guardian details</h2>
      <p class="muted">All fields are required.</p>
    </div>

    <div class="error-summary" tabindex="-1" hidden>
      <h3 class="error-summary__title">
        <Icon name="alert" />
        <span>Check the highlighted fields</span>
      </h3>
      <ul role="list"></ul>
    </div>

    <div class="field" data-field="name">
      <label for="name">Student's full name</label>
      <input id="name" name="name" type="text" autocomplete="off" required aria-describedby="name-error" />
      <p class="field__error" id="name-error" hidden></p>
    </div>

    <fieldset class="field" data-field="grade" aria-describedby="grade-error">
      <legend>Student's grade</legend>
      <div class="grades">
        {
          session.grades.map((g, i) => (
            <label class="grade">
              <input type="radio" name="grade" value={g} id={i === 0 ? "grade" : undefined} required />
              <span>{ordinal(g)} grade</span>
            </label>
          ))
        }
      </div>
      <p class="field__error" id="grade-error" hidden></p>
    </fieldset>

    <div class="field" data-field="email">
      <label for="email">Student's email</label>
      <input
        id="email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="off"
        spellcheck="false"
        required
        aria-describedby="email-error"
      />
      <p class="field__error" id="email-error" hidden></p>
    </div>

    <div class="field" data-field="guardian">
      <label for="guardian">Parent or guardian's full name</label>
      <input
        id="guardian"
        name="guardian"
        type="text"
        autocomplete="name"
        required
        aria-describedby="guardian-error"
      />
      <p class="field__error" id="guardian-error" hidden></p>
    </div>

    <div class="field" data-field="guardian_email">
      <label for="guardian_email">Parent or guardian's email</label>
      <p class="field__hint" id="guardian_email-hint">We'll send the confirmation and billing details here.</p>
      <input
        id="guardian_email"
        name="guardian_email"
        type="email"
        inputmode="email"
        autocomplete="email"
        spellcheck="false"
        required
        aria-describedby="guardian_email-hint guardian_email-error"
      />
      <p class="field__error" id="guardian_email-error" hidden></p>
    </div>

    <div class="signup__submit">
      <button type="submit" class="btn btn--primary">
        <span class="spinner" aria-hidden="true"></span>
        <span class="submit-label">Sign up</span>
      </button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </div>

    <div class="form-failure" role="alert" hidden>
      <Icon name="alert" />
      <div>
        <p><strong>Your sign-up didn't go through.</strong> Your answers are still filled in, so you can try again.</p>
        <p>
          If it keeps failing, email <a href={mailto(`Sign-up for ${session.name}`)}>{site.email}</a> and include
          your student's name and grade.
        </p>
      </div>
    </div>
  </form>

  <div class="signup__success" tabindex="-1" hidden>
    <p class="annot">Sign-up received</p>
    <h2>Thanks! We've got your sign-up.</h2>
    <p>
      We'll email <strong class="success-email"></strong> within about two business days with a confirmation and
      billing details.
    </p>
    <p class="muted">
      Questions in the meantime? Email <a href={mailto(`Sign-up for ${session.name}`)}>{site.email}</a>.
    </p>
    <button type="button" class="btn btn--secondary signup__again">Sign up another student</button>
  </div>

  <div class="signup__closed" hidden>
    <h2>Sign-ups for {session.name} have closed</h2>
    <p>
      Email <a href={mailto(offerings["in-person"].inquiry.subject)}>{site.email}</a> to ask about future sessions.
    </p>
  </div>
</div>

<style>
  .signup {
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .signup__form {
    display: grid;
    gap: var(--space-5);
  }

  .signup__intro {
    display: grid;
    gap: var(--space-1);
  }

  .signup__intro h2,
  .signup__success h2,
  .signup__closed h2 {
    font-size: var(--text-xl);
  }

  .field {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
    border: 0;
    padding: 0;
  }

  .field label,
  .field legend {
    font-weight: 650;
    padding: 0;
  }

  .field legend {
    margin-bottom: var(--space-2);
  }

  .field__hint {
    margin-top: calc(var(--space-1) * -1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .field input[type="text"],
  .field input[type="email"] {
    width: 100%;
    min-height: 48px;
    padding: 0.6rem 0.85rem;
    background: var(--color-surface);
    color: var(--color-text);
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    font-size: 1rem;
    transition: border-color var(--duration) var(--ease);
  }

  .field input:hover {
    border-color: var(--color-text);
  }

  .field input:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 1px;
    border-color: var(--color-text);
  }

  .field input[aria-invalid="true"] {
    border-color: var(--color-error);
    border-width: 2px;
  }

  .field__error {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    color: var(--color-error);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .field__error::before {
    content: "!";
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--color-error);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    transform: translateY(0.1em);
  }

  .grades {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: var(--space-2);
  }

  .grade {
    position: relative;
  }

  .grade input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .grade span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.5rem;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .grade input:hover + span {
    border-color: var(--color-text);
  }

  .grade input:checked + span {
    background: var(--color-text);
    border-color: var(--color-text);
    color: #fff;
  }

  .grade input:focus-visible + span {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  [data-field="grade"][data-invalid] .grade span {
    border-color: var(--color-error);
  }

  .error-summary {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    background: var(--color-error-bg);
    border-left: 4px solid var(--color-error);
    border-radius: var(--radius-sm);
  }

  .error-summary:focus {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .error-summary__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 1rem;
    color: var(--color-error);
  }

  .error-summary__title svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .error-summary ul {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
  }

  .error-summary a {
    color: var(--color-error);
    font-weight: 600;
  }

  [hidden] {
    display: none !important;
  }

  .signup__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding-top: var(--space-2);
  }

  .signup__submit .btn {
    min-width: 9rem;
  }

  .spinner {
    display: none;
    width: 1rem;
    height: 1rem;
    border: 2px solid rgb(255 255 255 / 0.4);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .signup__submit .btn[aria-busy="true"] .spinner {
    display: inline-block;
  }

  .signup__submit .btn[aria-busy="true"] {
    cursor: progress;
    opacity: 0.85;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spinner {
      animation: none;
      border-top-color: rgb(255 255 255 / 0.4);
    }
  }

  .form-status {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .form-failure {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--color-error-bg);
    border-left: 4px solid var(--color-error);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .form-failure > svg {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-error);
    margin-top: 0.15em;
  }

  .form-failure div {
    display: grid;
    gap: var(--space-2);
  }

  .signup__success,
  .signup__closed {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .signup__success:focus {
    outline: none;
  }

  .signup__success {
    padding: var(--space-5);
    margin: calc(var(--space-5) * -1);
    background: var(--color-success-bg);
    border-radius: var(--radius-md);
  }
</style>

<script>
  import {
    FIELD_ORDER,
    isAcceptingSignups,
    todayISO,
    toPayload,
    validateSignup,
    type SignupErrors,
    type SignupField,
    type SignupValues,
  } from "../lib/registration";

  const root = document.querySelector<HTMLElement>(".signup");

  if (root) {
    const form = root.querySelector<HTMLFormElement>("#signup-form")!;
    const summary = form.querySelector<HTMLElement>(".error-summary")!;
    const summaryList = summary.querySelector("ul")!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const submitLabel = submit.querySelector<HTMLElement>(".submit-label")!;
    const status = form.querySelector<HTMLElement>(".form-status")!;
    const failure = form.querySelector<HTMLElement>(".form-failure")!;
    const success = root.querySelector<HTMLElement>(".signup__success")!;
    const closed = root.querySelector<HTMLElement>(".signup__closed")!;
    const grades: number[] = JSON.parse(root.dataset.grades ?? "[]");
    const sdk = import("pocketbase");
    let submitting = false;

    if (!isAcceptingSignups({ registrationCloses: root.dataset.closes ?? "" }, todayISO())) {
      form.hidden = true;
      closed.hidden = false;
    }

    const readValues = (): SignupValues => {
      const data = new FormData(form);
      const get = (key: string) => String(data.get(key) ?? "");
      return {
        name: get("name"),
        grade: get("grade"),
        email: get("email"),
        guardian: get("guardian"),
        guardian_email: get("guardian_email"),
      };
    };

    const fieldEl = (field: SignupField) => form.querySelector<HTMLElement>(`[data-field="${field}"]`)!;

    const showErrors = (errors: SignupErrors) => {
      summaryList.replaceChildren();
      for (const field of FIELD_ORDER) {
        const wrap = fieldEl(field);
        const message = errors[field];
        const errorEl = wrap.querySelector<HTMLElement>(".field__error")!;
        const inputs = wrap.querySelectorAll<HTMLInputElement>("input");
        if (message) {
          errorEl.textContent = message;
          errorEl.hidden = false;
          wrap.toggleAttribute("data-invalid", true);
          inputs.forEach((input) => input.setAttribute("aria-invalid", "true"));
          const li = document.createElement("li");
          const link = document.createElement("a");
          link.href = `#${field}`;
          link.textContent = message;
          link.addEventListener("click", (event) => {
            event.preventDefault();
            const target = wrap.querySelector<HTMLInputElement>("input:checked") ?? inputs[0];
            target?.focus();
          });
          li.append(link);
          summaryList.append(li);
        } else {
          errorEl.textContent = "";
          errorEl.hidden = true;
          wrap.removeAttribute("data-invalid");
          inputs.forEach((input) => input.removeAttribute("aria-invalid"));
        }
      }
      const hasErrors = summaryList.children.length > 0;
      summary.hidden = !hasErrors;
      return hasErrors;
    };

    form.addEventListener("input", (event) => {
      const wrap = (event.target as HTMLElement).closest<HTMLElement>("[data-field]");
      if (!wrap?.hasAttribute("data-invalid")) return;
      const field = wrap.dataset.field as SignupField;
      const errors = validateSignup(readValues(), grades);
      if (!errors[field]) {
        const current: SignupErrors = {};
        for (const f of FIELD_ORDER) {
          if (f !== field && fieldEl(f).hasAttribute("data-invalid")) current[f] = errors[f];
        }
        showErrors(current);
      }
    });

    const setBusy = (busy: boolean) => {
      submitting = busy;
      submit.setAttribute("aria-busy", String(busy));
      submit.setAttribute("aria-disabled", String(busy));
      submitLabel.textContent = busy ? "Sending…" : "Sign up";
      status.textContent = busy ? "Sending your sign-up…" : "";
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submitting) return;
      failure.hidden = true;

      const values = readValues();
      const errors = validateSignup(values, grades);
      if (showErrors(errors)) {
        summary.focus();
        return;
      }

      setBusy(true);
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 20000);

      try {
        const { default: PocketBase } = await sdk;
        const pb = new PocketBase(root.dataset.pbUrl);
        const record = await pb
          .collection("signups")
          .create(toPayload(values), { requestKey: null, signal: controller.signal });

        if (!record?.id) throw new Error("No record id returned");

        success.querySelector(".success-email")!.textContent = values.guardian_email.trim();
        form.hidden = true;
        success.hidden = false;
        success.focus();
      } catch (error) {
        const { ClientResponseError } = await sdk;
        if (error instanceof ClientResponseError && error.status === 400) {
          const data = (error.response?.data ?? {}) as Record<string, { message?: string }>;
          const serverErrors: SignupErrors = {};
          for (const field of FIELD_ORDER) {
            if (data[field]) serverErrors[field] = data[field].message || "Check this field.";
          }
          if (showErrors(serverErrors)) {
            summary.focus();
            return;
          }
        }
        console.error("Sign-up failed", error);
        failure.hidden = false;
        failure.scrollIntoView({ block: "nearest" });
      } finally {
        window.clearTimeout(timeout);
        setBusy(false);
      }
    });

    root.querySelector(".signup__again")?.addEventListener("click", () => {
      form.reset();
      showErrors({});
      success.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>("#name")?.focus();
    });
  }
</script>
