<style>
    .navbar {
        background: #53c1ff;
        top: 0;
        width: 100%;
        position: fixed;
        height: 6vh;
        display: flex;
        align-items: center;
        color: white;
        justify-content: right;
        padding: 5px 0px;
        z-index: 1000;
    }

    .nav-item {
        font-family: "Signwood", sans-serif;
        font-style: italic;
        font-size: min(3.6vh, 4.6vw);
        margin: 10px 20px;
        line-height: 0.5;
        display: inline-block;
        color: white;
        /* Hacky Border Workaround */
        text-shadow:
            3px 0px 0 #53c1ff,
            3px 1px 0 #53c1ff,
            3px 2px 0 #53c1ff,
            3px 3px 0 #53c1ff,
            2px 3px 0 #53c1ff,
            1px 3px 0 #53c1ff,
            0px 3px 0 #53c1ff,
            -1px 3px 0 #53c1ff,
            -2px 3px 0 #53c1ff,
            -3px 3px 0 #53c1ff,
            -3px 2px 0 #53c1ff,
            -3px 1px 0 #53c1ff,
            -3px 0px 0 #53c1ff;
        border-bottom: 0px solid white;
        -webkit-transition: all 200ms ease-out;
        padding: 0px 15px;
    }
    .nav-select,
    .nav-item:hover {
        border-bottom: 10px solid white;
    }

    .nav-item:active {
        transform: translateY(10px);
    }
    .title {
        font-family: "Signwood", sans-serif;
        font-style: italic;
        font-size: min(4vh, 5vw);
        text-shadow: 3px 4px 0px black;
        justify-self: left;
        left: 40px;
        position: absolute;
    }

    @media (max-aspect-ratio: 3/4) {
        .home-item {
            display: none;
        }
    }
</style>
<div class="navbar">
    <a href="/" class="title home">RoboZone</a>
    <a href="/" class="nav-item home home-item">Home</a>
    <a href="/#about" class="nav-item about">About</a>
    <a href="/signup" class="nav-item signup">Sign Up</a>
</div>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Check if we're on the home page
        const isHomePage =
            window.location.pathname === "/" ||
            window.location.pathname === "/index.html";

        if (isHomePage) {
            // Add smooth scrolling for About section
            const aboutLink = document.querySelector(".about");
            const aboutSection = document.getElementById("about");

            if (aboutLink && aboutSection) {
                aboutLink.addEventListener("click", (e) => {
                    e.preventDefault();
                    aboutSection.scrollIntoView({ behavior: "smooth" });
                });
            }

            // Add smooth scrolling for Home (to top of page)
            const homeLinks = document.querySelectorAll(".home");
            homeLinks.forEach((link) => {
                link.addEventListener("click", (e) => {
                    e.preventDefault();
                    window.scrollTo({ top: 0, behavior: "smooth" });
                });
            });
        }
    });
</script>
