---
import Icon from "./Icon.astro";
import ProgramStatus from "./ProgramStatus.astro";
import { offerings, sessions, mailto, site } from "../data/site";
import { availabilityFor } from "../lib/programs";
import { formatDate, todayISO } from "../lib/registration";

interface Props {
  showRegister?: boolean;
}

const { showRegister = true } = Astro.props;
const a = availabilityFor(offerings["in-person"], sessions, todayISO());
const s = a.session;
const reg = a.registrable;
const registerHref = reg?.registration.kind === "link" ? reg.registration.url : "/signup#signup-form";
---

<section class="avail" aria-label="In-person course availability">
  <ProgramStatus availability={a} />

  {
    reg ? (
      <div class="avail__body">
        <h3>{reg.name}</h3>
        <ul role="list" class="avail__list">
          <li><Icon name="calendar" /><span>{reg.dates}<br /><span class="muted">{reg.schedule}</span></span></li>
          {reg.location && <li><Icon name="pin" /><span>{reg.location}</span></li>}
        </ul>
        <p class="muted">
          Fee: {reg.fee}. Registration closes {formatDate(reg.registrationCloses)}
          {reg.capacity && <> or when {reg.capacity} students have signed up</>}.
        </p>
        {showRegister && (
          <a class="btn btn--primary" href={registerHref}>
            Register for {reg.name}
          </a>
        )}
      </div>
    ) : s && (a.state === "upcoming" || a.state === "full") ? (
      <div class="avail__body">
        <h3>{s.name}</h3>
        {s.dates && <p>{s.dates}{s.schedule && <>, {s.schedule}</>}</p>}
        {s.location && <p class="muted">{s.location}</p>}
        {a.state === "upcoming" && s.registrationOpens && <p class="muted">Registration opens {formatDate(s.registrationOpens)}.</p>}
        {a.state === "full" && <p class="muted">This session is full.</p>}
        <a class="link-arrow" href={mailto(offerings["in-person"].inquiry.subject)}>
          <Icon name="mail" /> {offerings["in-person"].inquiry.label}
        </a>
      </div>
    ) : (
      <div class="avail__body">
        <h3>The next South Brunswick in-person session has not been scheduled.</h3>
        <p class="muted">
          The course itself is established: it's what RoboZone has taught since {site.founded}. Email us to ask about
          future dates. That's a question, not a registration.
        </p>
        <a class="btn btn--secondary" href={mailto(offerings["in-person"].inquiry.subject)}>
          <Icon name="mail" /> {offerings["in-person"].inquiry.label}
        </a>
      </div>
    )
  }
</section>

<style>
  .avail {
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .avail__body {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .avail h3 {
    font-size: var(--text-xl);
    letter-spacing: -0.015em;
  }

  .avail__list {
    display: grid;
    gap: var(--space-3);
  }

  .avail__list li {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: var(--space-3);
  }

  .avail__list svg {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.2em;
    color: var(--brand-blue);
  }

  .avail .btn {
    white-space: normal;
    margin-top: var(--space-2);
  }
</style>
