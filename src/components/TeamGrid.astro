---
import { Picture } from "astro:assets";
import { team } from "../data/site";

interface Props {
  bios?: boolean;
}

const { bios = false } = Astro.props;

const sharedRole = team.every((p) => p.role === team[0]?.role) ? team[0]?.role : null;
---

{sharedRole && <p class="team__shared annot">{sharedRole.split(" & ").map((r) => `${r}s`).join(" & ")}</p>}
<ul role="list" class:list={["team", { "team--bios": bios }]}>
  {
    team.map((person) => (
      <li class="team__person">
        <div class="team__photo">
          <Picture
            src={person.photo}
            alt=""
            widths={[320, 560, 960]}
            width={960}
            sizes="(min-width: 64rem) 260px, (min-width: 40rem) 30vw, 45vw"
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            quality={72}
            loading="lazy"
          />
        </div>
        <div class="team__text">
          <h3>{person.name}</h3>
          {!sharedRole && <p class="team__role">{person.role}</p>}
          {bios && <p class="team__bio">{person.bio}</p>}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .team__shared {
    margin-bottom: var(--space-4);
  }

  .team {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
  }

  .team__person {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .team__photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface-sunken);
  }

  .team__photo :global(picture) {
    display: contents;
  }

  .team__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
  }

  .team__text {
    display: grid;
    gap: var(--space-1);
  }

  .team__text h3 {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }

  .team__role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .team__bio {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 64rem) {
    .team {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .team:not(.team--bios) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .team,
    .team:not(.team--bios) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) var(--space-4);
    }
  }
</style>
