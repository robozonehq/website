---
import { curriculum } from "../data/site";
import type { PhotoKey } from "../data/photos";
import CircuitDiagram from "./CircuitDiagram.astro";
import WorkshopPhoto from "./WorkshopPhoto.astro";

interface Props {
  detailed?: boolean;
}

const { detailed = false } = Astro.props;

const stagePhoto: Record<string, { photo: PhotoKey; kind?: string; caption?: string; aspect?: string }> = {
  code: { photo: "mentorCode", caption: "Laptops and breadboard circuits side by side, with a mentor at the table." },
  "motion-cad": { photo: "onshapeCad" },
  final: { photo: "printedEnclosures", kind: "Student builds", aspect: "16 / 9" },
};
---

<ol class="journey" role="list">
  {
    curriculum.map((stage, i) => {
      const media = stagePhoto[stage.id];
      return (
        <li class="journey__stage" id={`stage-${stage.id}`}>
          <div class="journey__rail" aria-hidden="true">
            <span class="journey__pad" />
          </div>

          <div class="journey__content">
            <p class="annot annot--plain">
              Stage {i + 1} · {stage.label}
            </p>
            <h3>{stage.title}</h3>
            <p>{stage.summary}</p>
            {detailed && (
              <ul class="journey__topics">
                {stage.topics.map((topic) => (
                  <li>{topic}</li>
                ))}
              </ul>
            )}
          </div>

          <div class="journey__media">
            {stage.id === "circuits" ? (
              <CircuitDiagram />
            ) : (
              media && (
                <WorkshopPhoto
                  photo={media.photo}
                  kind={media.kind}
                  caption={media.caption}
                  aspect={media.aspect ?? "4 / 3"}
                  aspectSm={media.aspect ?? "4 / 3"}
                  sizes="(min-width: 64rem) 520px, 100vw"
                  widths={[480, 720, 1040]}
                />
              )
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .journey {
    --rail: 2.25rem;
    display: grid;
  }

  .journey__stage {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: var(--space-4);
    padding-bottom: var(--space-7);
  }

  .journey__stage:last-child {
    padding-bottom: 0;
  }

  .journey__rail {
    position: relative;
    grid-row: 1 / span 2;
  }

  .journey__rail::after {
    content: "";
    position: absolute;
    top: 1.6rem;
    bottom: calc(var(--space-7) * -1);
    left: calc(50% - 1.5px);
    width: 3px;
    background: var(--brand-blue);
    border-radius: 2px;
  }

  .journey__stage:last-child .journey__rail::after {
    display: none;
  }

  .journey__pad {
    position: relative;
    z-index: 1;
    display: block;
    width: 1.375rem;
    height: 1.375rem;
    margin: 0.1rem auto 0;
    background: radial-gradient(circle, var(--color-bg) 0 3px, var(--color-text) 3.5px 4.5px, transparent 5px),
      var(--brand-yellow);
    border: 2px solid var(--color-text);
    border-radius: 4px;
  }

  .journey__content {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    max-width: 36rem;
  }

  .journey__content h3 {
    font-size: var(--text-xl);
  }

  .journey__content > p:not(.annot) {
    color: var(--color-text-muted);
  }

  .journey__topics {
    display: grid;
    gap: var(--space-2);
    padding-left: 0;
    list-style: none;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .journey__topics li {
    display: grid;
    grid-template-columns: 0.75rem 1fr;
    gap: var(--space-3);
    align-items: baseline;
  }

  .journey__topics li::before {
    content: "";
    width: 0.5rem;
    height: 2px;
    background: var(--color-text);
    transform: translateY(-0.3em);
  }

  .journey__media {
    grid-column: 2;
    margin-top: var(--space-5);
    max-width: 36rem;
  }

  @media (min-width: 64rem) {
    .journey__stage {
      grid-template-columns: var(--rail) minmax(0, 0.9fr) minmax(0, 1.1fr);
      column-gap: var(--space-6);
    }

    .journey__media {
      grid-column: 3;
      grid-row: 1 / span 2;
      margin-top: 0;
      max-width: none;
    }
  }
</style>
